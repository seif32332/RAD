generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. Core Structure: Users, Roles, Companies & Branches
// ---------------------------------------------------------

// --- الجنسيات ---
model Nationality {
  id        String   @id @default(uuid())
  label     String   @unique // الاسم بالعربية
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  FINANCE_MANAGER
  PAYROLL_ADMIN
  GOV_RELATIONS
  LEGAL_ADMIN
  BRANCH_MANAGER
  EMPLOYEE
  DEPT_MANAGER
  PURCHASING_AGENT
}

model RolePermission {
  id           String   @id @default(uuid())
  role         Role     @unique
  allowedPages String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  role         Role    @default(EMPLOYEE)
  isActive     Boolean @default(true)
  name         String? // اسم العرض
  avatarUrl    String? // صورة الملف الشخصي

  // 2FA Security (التحقق بخطوتين)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  /// Incremented on logout / password change / deactivation: revokes older sessions
  sessionVersion   Int     @default(0)
  /// موظف انتهت خدمته: الدخول لمستنداته الرسمية فقط (تنزيل وموافقة على المخالصة) حتى هذا الوقت، ثم يُعطَّل الحساب
  documentsOnlyUntil DateTime?

  // BL-PAY-005 (9zk_identity_controls): identity controls (pay-to-be.md BR-PAY-005, §2, §17; DEC-PO-013 / 016 /
  // 021 / 024 / 027). Written only inside the iam identity operations (money.gateway refuses them elsewhere).
  /// Who created the account. NULL: created before 9zk and not found in AuditLog, or by a vendor script.
  createdById            String?
  /// Radeef (vendor) staff: TRUE only from the vendor scripts (seed.mjs, create-admin.mjs); never in-app.
  isVendorStaff          Boolean             @default(false)
  identityStatus         IdentityStatus      @default(UNATTESTED)
  identityAttestedById   String?
  identityAttestedAt     DateTime?
  /// The email the attester confirmed belongs to the person; credential links go there only (RT-PAY-1001).
  attestedEmail          String?
  /// A user with no employee file: who attested he is a real person (BR-PAY-005).
  noEmployeeAttestedById String?
  /// Why the last attestation was dropped (decides who may re-attest), and when.
  identityDroppedReason  IdentityDropReason?
  identityDroppedAt      DateTime?
  /// TENANT_ROOT (DEC-PO-016): marked by Radeef from the vendor panel only (BL-PAY-017). At most one per tenant.
  tenantRoot             Boolean             @default(false)
  /// Root powers suspended (root credential reset RT-PAY-1004; approved exit DEC-PO-042).
  rootSuspendedAt        DateTime?
  /// Who last set the login email, and when (the holder, an admin, NULL = a vendor script or unknown). An
  /// attester never attests an account whose email he (or someone he attested) set (BL-PAY-005 review).
  emailSetById           String?
  emailSetAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeProfile Employee?
  auditLogs       AuditLog[]
  // 9zk_identity_controls (BL-PAY-005)
  createdBy                    User?                   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usersCreated                 User[]                  @relation("UserCreatedBy")
  identityAttestedBy           User?                   @relation("UserIdentityAttestedBy", fields: [identityAttestedById], references: [id], onDelete: Restrict)
  identitiesAttested           User[]                  @relation("UserIdentityAttestedBy")
  noEmployeeAttestedBy         User?                   @relation("UserNoEmployeeAttestedBy", fields: [noEmployeeAttestedById], references: [id], onDelete: Restrict)
  noEmployeeAttested           User[]                  @relation("UserNoEmployeeAttestedBy")
  emailSetBy                   User?                   @relation("UserEmailSetBy", fields: [emailSetById], references: [id], onDelete: Restrict)
  emailsSet                    User[]                  @relation("UserEmailSetBy")
  employeeLinks                UserEmployeeLink[]      @relation("UserEmployeeLinkUser")
  employeeLinksProposed        UserEmployeeLink[]      @relation("UserEmployeeLinkProposedBy")
  employeeLinksConfirmed       UserEmployeeLink[]      @relation("UserEmployeeLinkConfirmedBy")
  employeeLinksEnded           UserEmployeeLink[]      @relation("UserEmployeeLinkEndedBy")
  credentialTokens             CredentialToken[]       @relation("CredentialTokenUser")
  credentialTokensIssued       CredentialToken[]       @relation("CredentialTokenIssuedBy")
  credentialTokensAttested     CredentialToken[]       @relation("CredentialTokenAttester")
  identityChangeRequests       IdentityChangeRequest[] @relation("IdentityChangeTarget")
  identityChangesRequested     IdentityChangeRequest[] @relation("IdentityChangeRequestedBy")
  identityChangesDecided       IdentityChangeRequest[] @relation("IdentityChangeDecidedBy")
  // 9zl_tenant_named_person (BL-PAY-017 / BL-PAY-022)
  namedPersons                 TenantNamedPerson[]     @relation("TenantNamedPersonUser")
  uploadedFiles   UploadedFile[]
  companyScopes                UserCompanyScope[]     @relation("ScopedUser") // back-relations of the foreign keys added by 9x_db_constraints (P1-FND-DB)
  paymentsRequested            PaymentRequest[]       @relation("PaymentRequestedBy")
  paymentsApproved             PaymentRequest[]       @relation("PaymentApprovedBy")
  paymentsPaid                 PaymentRequest[]       @relation("PaymentPaidBy")
  salaryChangesCreated         SalaryChange[]         @relation("SalaryChangeCreatedBy")
  headcountPlansCreated        HeadcountPlan[]        @relation("HeadcountPlanCreatedBy")
  headcountPlansDecided        HeadcountPlan[]        @relation("HeadcountPlanDecidedBy")
  punchesReviewed              AttendancePunch[]      @relation("PunchReviewedBy")
  evaluationApprovals          EvaluationApproval[]   @relation("EvaluationApprover")
  ruleParametersCreated        RuleParameter[]        @relation("RuleParameterCreatedBy")
  holidaysCreated              HolidayCalendar[]      @relation("HolidayCreatedBy")
  ramadanPeriodsCreated        RamadanPeriod[]        @relation("RamadanCreatedBy")
  nitaqatCurvesCreated         NitaqatCurve[]         @relation("NitaqatCurveCreatedBy")
  localizationDecisionsCreated LocalizationDecision[] @relation("LocalizationDecisionCreatedBy")
  workforceCalculations        WorkforceCalculation[] @relation("WorkforceCalculationCreatedBy")
  workforceAssumptionsSet      WorkforceAssumption[]  @relation("WorkforceAssumptionUpdatedBy")
  companyScopesGranted         UserCompanyScope[]     @relation("UserCompanyScopeCreatedBy")
  muqeemTransactions           MuqeemTransaction[]    @relation("MuqeemTransactionRequestedBy")
  // P1-PAY-A (9zf_payroll_gateway): actor columns of the money tables (BR-PAY-006, BR-PAY-011: RESTRICT)
  payrollsGenerated          Payroll[]         @relation("PayrollGeneratedBy")
  payrollsApproved           Payroll[]         @relation("PayrollApprovedBy")
  payrollsPaid               Payroll[]         @relation("PayrollPaidBy")
  payrollMonthsCalculated    PayrollMonth[]    @relation("PayrollMonthCalculatedBy")
  payrollMonthsApproved      PayrollMonth[]    @relation("PayrollMonthApprovedBy")
  payrollMonthsPaid          PayrollMonth[]    @relation("PayrollMonthPaidBy")
  loansCreated               Loan[]            @relation("LoanCreatedBy")
  loansManagerApproved       Loan[]            @relation("LoanManagerApprovedBy")
  loansHrApproved            Loan[]            @relation("LoanHrApprovedBy")
  loansOwnerApproved         Loan[]            @relation("LoanOwnerApprovedBy")
  loansTransferred           Loan[]            @relation("LoanTransferredBy")
  loansFinanceReviewed       Loan[]            @relation("LoanFinanceReviewedBy")
  loansForgiven              Loan[]            @relation("LoanForgivenBy")
  loansRejected              Loan[]            @relation("LoanRejectedBy")
  deductionsIssued           Deduction[]       @relation("DeductionIssuedBy")
  deductionsDecided          Deduction[]       @relation("DeductionDecidedBy")
  overtimesCreated           OvertimeRequest[] @relation("OvertimeCreatedBy")
  overtimesDecided           OvertimeRequest[] @relation("OvertimeDecidedBy")
  allowancesCreated          Allowance[]       @relation("AllowanceCreatedBy")
  allowancesApproved         Allowance[]       @relation("AllowanceApprovedBy")
  settlementsCreated         Settlement[]      @relation("SettlementCreatedBy")
  settlementsApproved        Settlement[]      @relation("SettlementApprovedBy")
  settlementsPaid            Settlement[]      @relation("SettlementPaidBy")
  // P1-PAY-B (9zg_financial_change): actors of EmployeeFinancialChange (BR-PAY-006, RESTRICT)
  financialChangesRequested  EmployeeFinancialChange[] @relation("FinancialChangeRequestedBy")
  financialChangesDecided    EmployeeFinancialChange[] @relation("FinancialChangeDecidedBy")
  financialChangesCancelled  EmployeeFinancialChange[] @relation("FinancialChangeCancelledBy")
  // 9zj_workflow_engine (WFE-001, ADR-0006)
  workflowDefinitionsCreated   WorkflowDefinition[] @relation("WorkflowDefinitionCreatedBy")
  workflowDefinitionsActivated WorkflowDefinition[] @relation("WorkflowDefinitionActivatedBy")
  workflowDefinitionsEdited    WorkflowDefinition[] @relation("WorkflowDefinitionLastEditedBy")
  workflowDefinitionsRetireRequested WorkflowDefinition[] @relation("WorkflowDefinitionRetireRequestedBy")
  workflowDefinitionsRetired   WorkflowDefinition[] @relation("WorkflowDefinitionRetiredBy")
  workflowInstancesRequested   WorkflowInstance[]   @relation("WorkflowInstanceRequester")
  workflowInstancesClosed      WorkflowInstance[]   @relation("WorkflowInstanceClosedBy")
  workflowTasksActed           WorkflowTask[]       @relation("WorkflowTaskActedBy")
  workflowTasksOnBehalfOf      WorkflowTask[]       @relation("WorkflowTaskOnBehalfOf")
  delegationsFrom              ApprovalDelegation[] @relation("ApprovalDelegationFrom")
  delegationsTo                ApprovalDelegation[] @relation("ApprovalDelegationTo")
  delegationsCreated           ApprovalDelegation[] @relation("ApprovalDelegationCreatedBy")
  delegationsRevoked           ApprovalDelegation[] @relation("ApprovalDelegationRevokedBy")
}

// --- ضوابط الهوية (BL-PAY-005, 9zk_identity_controls; owner iam) ---

/// UNATTESTED: not a real second person yet (every account at rollout, DEC-PO-013, and every new one).
/// ATTESTED: attested by a person chained to TENANT_ROOT. VENDOR_BOOTSTRAP: an account a vendor script
/// created (vendor identity only, never an attestation for approvals).
enum IdentityStatus {
  UNATTESTED
  ATTESTED
  VENDOR_BOOTSTRAP
}

/// Why an attestation was dropped. CREDENTIAL_RESET and PROMOTION: only TENANT_ROOT re-attests (DEC-PO-027).
enum IdentityDropReason {
  CREDENTIAL_RESET
  PROMOTION
  EMAIL_CHANGE
  /// 9zl (DEC-PO-143): Radeef revoked the named person the account was attested as (ROOT_ONLY re-attests).
  NAMED_PERSON_REVOKED
}

/// PROPOSED (one admin) -> CONFIRMED (a second person, BR-PAY-005) | REJECTED | CANCELLED; CONFIRMED or
/// LEGACY_LINKED (an Employee.userId found at 9zk; confirmed by the attestation itself) -> ENDED (unlink).
enum UserEmployeeLinkStatus {
  PROPOSED
  CONFIRMED
  LEGACY_LINKED
  REJECTED
  CANCELLED
  ENDED
}

/// The two-step link between a login and an employee file (BR-PAY-005). Employee.userId is its projection
/// (written by the same iam operation): the access link of the self-service portal.
model UserEmployeeLink {
  id                    String                 @id @default(uuid())
  userId                String
  employeeId            String
  status                UserEmployeeLinkStatus
  /// NULL only for LEGACY_LINKED rows created by 9zk.
  proposedById          String?
  proposedAt            DateTime               @default(now())
  confirmedById         String?
  confirmedAt           DateTime?
  /// The confirmation broke a two-person rule and went through as a recorded SINGLE_OPERATOR self-act.
  selfActSingleOperator Boolean                @default(false)
  /// An access link that existed before 9zk (Employee.userId): it has no proposer (LEGACY_LINKED, then
  /// CONFIRMED by the attestation itself, §17).
  legacy                Boolean                @default(false)
  endedById             String?
  endedAt               DateTime?
  endReason             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user        User     @relation("UserEmployeeLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  proposedBy  User?    @relation("UserEmployeeLinkProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  confirmedBy User?    @relation("UserEmployeeLinkConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  endedBy     User?    @relation("UserEmployeeLinkEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([employeeId])
}

/// RESET: identity.resetCredentials (the holder chooses his password, DEC-PO-027). FIRST_ATTESTATION: the
/// two-channel setup of a first attestation (link + a code the attester hands over, RT-PAY-1102 / 1201).
/// INVITE: Radeef's invitation of a person the owner named (BL-PAY-022, pay-to-be "الشخص المسمّى"): the holder
/// chooses his first password; the account stays UNATTESTED.
enum CredentialTokenPurpose {
  RESET
  FIRST_ATTESTATION
  INVITE
}

/// Who hands over the second-channel code of a first attestation: the attester in person (RT-PAY-1201), or
/// Radeef from the vendor panel (ROOT_ATTEST_OWN, DEC-PO-018 / RT-PAY-1301: the root never holds the code).
enum CredentialCodeDelivery {
  ATTESTER
  VENDOR
}

/// NAMED_PERSON: a person the business owner named in his formal request to Radeef (DEC-PO-018, ROOT_ATTEST_OWN).
/// OWNER_CONTACT: the owner's own contact for the DEC-PO-022 channel (digest, confirmations). Both written by
/// Radeef's vendor panel only (BL-PAY-017 / BL-PAY-022).
enum TenantNamedPersonKind {
  NAMED_PERSON
  OWNER_CONTACT
}

/// The owner's formal request to Radeef, as a protected list (pay-to-be BR-PAY-005 "الأشخاص المسمَّون", §17;
/// DEC-PO-016 / 018 / 022; RT-PAY-702 / 1301 / 1403). iam table, sole writer the vendor operations
/// (src/modules/iam/vendor, run by radeef-manage over SSH); no in-app code writes it (money.gateway refuses).
/// The national id is kept only as a keyed hash. A revoked row stays (history); a new request adds a new row.
model TenantNamedPerson {
  id               String                @id @default(uuid())
  kind             TenantNamedPersonKind
  /// Lower case. NAMED_PERSON: the address the ROOT_ATTEST_OWN link goes to (attestedEmail = this, RT-PAY-1301).
  email            String?
  /// OWNER_CONTACT: the owner's mobile (DEC-PO-022).
  mobile           String?
  name             String?
  /// HMAC-SHA256 of the national id / iqama number with the tenant's data key (never the number itself).
  nationalIdHash   String?
  /// The reference of the owner's formal request (ticket / letter number).
  requestRef       String
  /// The vendor operator who registered it (radeef-manage user).
  addedBy          String
  addedAt          DateTime              @default(now())
  /// The account of the named person (BL-PAY-023 / RT-PAY-1403: written by Radeef only). An email change of
  /// that account after linkedAt breaks the link for ROOT_ATTEST_OWN (pay-to-be "يفك ربطه بالقائمة").
  /// One open (not revoked) row per account: partial unique index of 9zl.
  userId           String?
  linkedAt         DateTime?
  linkedBy         String?
  revokedAt        DateTime?
  revokedBy        String?
  revokeRequestRef String?

  user User? @relation("TenantNamedPersonUser", fields: [userId], references: [id], onDelete: Restrict)
  credentialTokens CredentialToken[]

  @@index([kind, revokedAt])
  @@index([userId])
}

/// BL-PAY-021 (ADR-0009, DEC-PO-144): Radeef marks a legal company READY for the computed controls mode. Until a
/// company has an open (not revoked) row, its mode is ENFORCED whatever its count of attested approvers. Written
/// only by the iam vendor operation iam.vendor.controlsReadiness (vendor CLI, money.gateway VENDOR_ONLY_TABLES);
/// one open row per company (partial unique index of 9zm). basis: ATTESTED (the root and approvers are attested)
/// | ONE_PERSON (a genuine one-person company, on the owner's request); CHECK in 9zm.
model ControlsReadiness {
  id               String    @id @default(uuid())
  companyId        String
  basis            String
  /// The reference of the owner's formal request.
  requestRef       String
  /// The vendor operator (radeef-manage user).
  markedBy         String
  markedAt         DateTime  @default(now())
  revokedAt        DateTime?
  revokedBy        String?
  revokeRequestRef String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, revokedAt])
}

/// A one-time credential link. The secret is never stored: it is derived from the row id with the server
/// key, and only its keyed hash is kept (tokenHash; codeHash for the in-person code). Single use, short expiry.
model CredentialToken {
  id               String                 @id @default(uuid())
  userId           String
  purpose          CredentialTokenPurpose
  tokenHash        String                 @unique
  codeHash         String?
  /// The address the link goes to (the attested email when there is one).
  sentTo           String
  /// Keyed hash of the account's password hash when the link was issued: any later credential change (a
  /// vendor-script reset, a self change) makes the link unusable.
  credentialFingerprint String
  issuedById       String?
  /// FIRST_ATTESTATION: the attester, and how he verified the person outside the system.
  attesterId       String?
  verificationNote String?
  /// RESET: the IdentityChangeRequest that ordered it.
  changeRequestId  String?
  expiresAt        DateTime
  attempts         Int                    @default(0)
  usedAt           DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  /// 9zl (BL-PAY-022): who delivers the code. VENDOR = ROOT_ATTEST_OWN; the code is released once to the
  /// vendor operator (codeReleasedAt) and never shown in-app. namedPersonId: the list entry it relies on.
  codeDelivery     CredentialCodeDelivery @default(ATTESTER)
  codeReleasedAt   DateTime?
  namedPersonId    String?
  createdAt        DateTime               @default(now())

  user          User                   @relation("CredentialTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy      User?                  @relation("CredentialTokenIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  attester      User?                  @relation("CredentialTokenAttester", fields: [attesterId], references: [id], onDelete: Restrict)
  changeRequest IdentityChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  namedPerson   TenantNamedPerson?     @relation(fields: [namedPersonId], references: [id], onDelete: Restrict)

  @@index([userId])
}

/// DEACTIVATE / CHANGE_ROLE of an account that counts toward ENFORCED (DEC-PO-021, identity.deactivateApprover)
/// and RESET_CREDENTIALS (DEC-PO-024: two people for such an account; recorded for every reset so the
/// re-attestation excludes whoever asked for or approved it, DEC-PO-027).
enum IdentityChangeKind {
  DEACTIVATE
  CHANGE_ROLE
  RESET_CREDENTIALS
  /// BL-PAY-021: a company scope change that drops a company below two counted approvers (DEC-PO-021).
  CHANGE_SCOPE
}

enum IdentityChangeStatus {
  PENDING
  EXECUTED
  REJECTED
  CANCELLED
}

model IdentityChangeRequest {
  id            String               @id @default(uuid())
  userId        String
  kind          IdentityChangeKind
  nextRole      Role?
  /// CHANGE_SCOPE: the requested companies of the account (empty = every company). BL-PAY-021.
  nextCompanyIds String[]            @default([])
  status        IdentityChangeStatus
  /// A second person (the user himself or another attested admin) had to approve it.
  twoPerson     Boolean
  requestedById String
  requestedAt   DateTime             @default(now())
  reason        String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  executedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user             User              @relation("IdentityChangeTarget", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy      User              @relation("IdentityChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy        User?             @relation("IdentityChangeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  credentialTokens CredentialToken[]

  @@index([userId, status])
  @@index([status, requestedAt])
}

// --- وحدة التدقيق (Audit Logs) ---
model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  action     String // CREATE, UPDATE, DELETE, LOGIN, APPROVE, VIEW
  entityType String // e.g., Employee, Payroll, PromissoryNote
  entityId   String?
  details    String? // JSON string containing changes
  ipAddress  String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- ادارة الشركات ---
model Company {
  id          String  @id @default(uuid())
  nameArabic  String
  nameEnglish String?

  unifiedNumber String? // الرقم الموحد

  commercialRegNum  String    @unique
  commercialRegUrl  String? // إضافة المرفق للسجل التجاري
  commercialRegDate DateTime? // تاريخ بداية السجل/النشاط
  commercialRegExp  DateTime // تاريخ الانتهاء/التأكيد السنوي
  commercialRegCost Float?    @default(0) // تكلفة تجديد السجل التجاري

  taxNumber               String? // الرقم الضريبي
  molEstablishmentNumber  String? // رقم المنشأة في وزارة الموارد البشرية
  gosiEstablishmentNumber String? // رقم المنشأة في التأمينات الاجتماعية
  moiNumber               String? // رقم المنشأة في الجوازات (700) المستخدم في مقيم
  muqeemPlatformId        String? // حساب مقيم المخزن مشفراً في خزنة المنصات الحكومية
  nitaqatActivity         String? // نشاط المنشأة في نطاقات (سطر ملحق الدليل)
  nitaqatActivityKey      String? // مفتاح نشاط نطاقات في جدول NitaqatActivity (منحنى النطاقات الرسمي)
  isIndustrialLicensed    Boolean @default(false) // منشأة صناعية مرخّصة (المقابل المالي ملغى)
  // --- إعدادات الكلفة للشركة (تُضبط مرة واحدة وتُستخدم في الرواتب والمحرك) ---
  overtimeHourlyBasis     String  @default("BASIC") // BASIC: الساعة × 150% من الأساسي؛ TOTAL_PLUS_HALF_BASIC: أجر الساعة الإجمالي + 50% من الأساسي (المادة 107)
  iqamaFeeYear            Float? // رسوم الإقامة السنوية (فارغ = قيمة سجل القواعد)
  medicalPremiumsJson     String? @db.Text // أقساط التأمين الطبي السنوية لكل فئة: {"VIP":0,"A+":0,"A":0,"B":0,"C":0,"DEPENDENT":0}
  taxCertificateUrl       String? // مرفق الشهادة الضريبية
  nationalAddress         String? // العنوان الوطني (الرقم المختصر)
  nationalAddressUrl      String? // مرفق العنوان الوطني

  establishmentDeedUrl String? // عقد التأسيس

  // العلامة التجارية
  trademarkNumber  String?
  trademarkRegDate DateTime?
  trademarkExpDate DateTime?
  trademarkCertUrl String?
  trademarkCost    Float?    @default(0) // تكلفة العلامة التجارية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]

  legalEmployees  Employee[] @relation("LegalCompany")
  actualEmployees Employee[] @relation("ActualCompany")

  legalAssignmentPeriods  AssignmentPeriod[] @relation("AssignmentLegalCompany")
  actualAssignmentPeriods AssignmentPeriod[] @relation("AssignmentActualCompany")

  // calendar (P1-CAL, 9z_calendar)
  workPatterns   WorkSchedule[]    @relation("WorkPatternCompany")
  holidays       HolidayCalendar[] @relation("HolidayCompany")
  ramadanPeriods RamadanPeriod[]   @relation("RamadanCompany")

  // rules (P1-RULE, 9za_rules)
  ruleOverrides CompanyRuleOverride[] @relation("RuleOverrideCompany")

  telecomSims    TelecomSim[]
  legalMeters    UtilityMeter[] @relation("LegalMeterOwner")
  actualMeters   UtilityMeter[] @relation("ActualMeterUser")
  legalVehicles  Vehicle[]      @relation("LegalVehicleOwner")
  actualVehicles Vehicle[]      @relation("ActualVehicleUser")

  violations        ComplianceViolation[]
  medicalInsurances MedicalInsurance[]
  administrations   Administration[]
  // back-relations of the foreign keys added by 9x_db_constraints (P1-FND-DB)
  jobRequests        JobRequest[]          @relation("JobRequestCompany")
  onboardingRequests OnboardingRequest[]   @relation("OnboardingCompany")
  muqeemTransactions MuqeemTransaction[]   @relation("MuqeemTransactionCompany")
  headcountPlans     HeadcountPlan[]       @relation("HeadcountPlanCompany")
  // P1-PAY-A (9zf): payroll per company and month (ARC-PAY-A7, DOMAIN_BOUNDARIES §5.4.3 payroll key)
  payrollMonths      PayrollMonth[]        @relation("PayrollMonthCompany")
  payrolls           Payroll[]             @relation("PayrollCompany")
  financialChanges   EmployeeFinancialChange[] // 9zg_financial_change (P1-PAY-B)
  workflowDefinitions WorkflowDefinition[] // 9zj_workflow_engine (WFE-001)
  workflowInstances   WorkflowInstance[]
  workflowTasks       WorkflowTask[]

  // محرك إصدار المستندات (docs/document-engine): الشركة هنا هي الجهة النظامية المُصدِرة
  brandProfile         BrandProfile?
  documentAssets       DocumentAsset[]
  signatories          Signatory[]
  documentTypeSettings DocumentTypeSetting[]
  documentRequests     DocumentRequest[]
  issuedDocuments      IssuedDocument[]
  userScopes           UserCompanyScope[]
  /// BL-PAY-021 (ADR-0009): Radeef's readiness mark for the computed controls mode (iam, vendor only).
  controlsReadiness    ControlsReadiness[]
  muqeemPlatform       GovPlatform?          @relation("CompanyMuqeemPlatform", fields: [muqeemPlatformId], references: [id], onDelete: SetNull)

  // P1-SCOPE (9zb): scope keys of the gov, legal and assets tables (DOMAIN_BOUNDARIES §5.4.3)
  govPlatforms      GovPlatform[]     @relation("GovPlatformCompany")
  legalContracts    LegalContract[]   @relation("LegalContractCompany")
  lawsuits          Lawsuit[]         @relation("LawsuitCompany")
  promissoryNotes   PromissoryNote[]  @relation("PromissoryNoteCompany")
  certifiedAgencies CertifiedAgency[] @relation("CertifiedAgencyCompany")
  assets            Asset[]           @relation("AssetCompany")

  @@index([commercialRegExp])
  @@index([trademarkExpDate])
}

// --- الادارات (تحت الشركة وقبل الفروع) ---
model Administration {
  id          String  @id @default(uuid())
  companyId   String
  nameArabic  String
  nameEnglish String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branches  Branch[]
  employees Employee[]
  onboardingRequests OnboardingRequest[] @relation("OnboardingAdministration") // 9x_db_constraints

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// --- ادارة الفروع ---
model Branch {
  id               String  @id @default(uuid())
  companyId        String
  administrationId String?
  nameArabic       String
  nameEnglish      String?

  administration Administration? @relation(fields: [administrationId], references: [id], onDelete: SetNull)

  // العنوان
  city       String?
  district   String?
  street     String?
  branchCode String?

  // رخصة البلدية
  munLicenseNum   String?
  munLicenseStart DateTime?
  munLicenseExp   DateTime?
  munLicenseUrl   String?   @db.Text // مرفق رخصة البلدية
  munLicenseCost  Float?    @default(0) // تكلفة رخصة البلدية

  // رخصة الدفاع المدني
  civilDefenseNum   String?
  civilDefenseStart DateTime?
  civilDefenseExp   DateTime?
  civilDefenseUrl   String?   @db.Text // مرفق شهادة الدفاع المدني
  civilDefenseCost  Float?    @default(0) // تكلفة رخصة الدفاع المدني

  // عقد الايجار
  rentContractNum   String?
  rentContractStart DateTime?
  rentContractExp   DateTime?
  rentOwnerName     String?
  rentOwnerPhone    String?

  // تفاصيل سداد الإيجار
  rentContractAmount Float?
  rentPaymentType    String? // ANNUAL, SEMI_ANNUAL, QUARTERLY, MONTHLY
  rentPaymentCount   Int?
  rentContractUrl    String? @db.Text
  rentContractType   String?

  // عقد النفايات
  wasteContractNum   String?
  wasteContractStart DateTime?
  wasteContractExp   DateTime?
  wasteCompanyName   String?
  wasteCompanyPhone  String?
  wasteContractUrl   String?

  // عقد صيانة سلامة
  safetyContractNum   String?
  safetyContractStart DateTime?
  safetyContractExp   DateTime?
  safetyCompanyName   String?
  safetyCompanyPhone  String?
  safetyContractUrl   String?   @db.Text

  // عقد صيانة الكاميرات
  cameraContractNum   String?
  cameraContractStart DateTime?
  cameraContractExp   DateTime?
  cameraCompanyName   String?
  cameraCompanyPhone  String?
  cameraContractUrl   String?   @db.Text

  // المرفقات
  buildingLicenseUrl      String? // رخصة البناء
  blueprintsUrl           String? // المخططات
  engineeringHandoverUrl  String? // شهادة الاستلام الهندسي
  installationCompleteUrl String? // شهادة انهاء التركيبات
  externalPhotosUrls      String? // صور المحل من الخارج
  locationUrl             String? // رابط النقر لموقع خرائط جوجل

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  employees   Employee[]

  assignmentPeriods AssignmentPeriod[]

  telecomSims         TelecomSim[]
  utilityMeters       UtilityMeter[]
  workSchedules       WorkSchedule[]
  violations          ComplianceViolation[]
  attendanceLocations AttendanceLocation[]
  // back-relations of the foreign keys added by 9x_db_constraints (P1-FND-DB)
  transfersFrom       TransferRequest[]     @relation("TransferFromBranch")
  transfersTo         TransferRequest[]     @relation("TransferToBranch")
  onboardingRequests  OnboardingRequest[]   @relation("OnboardingBranch")

  @@index([companyId])
  @@index([administrationId])
  @@index([munLicenseExp])
  @@index([civilDefenseExp])
  @@index([rentContractExp])
}

model WorkSchedule {
  id       String @id @default(uuid())
  branchId String
  name     String // اسم جدول العمل (مثال: دوام نهاري منتظم)

  shiftType  String? @default("ONE_SHIFT") // ONE_SHIFT أو TWO_SHIFTS أو FLEXIBLE
  startTime  String? // وقت بداية الدوام
  endTime    String? // وقت نهاية الدوام
  startTime2 String? // وقت بداية الفترة الثانية
  endTime2   String? // وقت نهاية الفترة الثانية

  flexibleHours          Int? // عدد الساعات لجدول العمل المرن
  isExemptFromAttendance Boolean? @default(false) // إعفاء من البصمة والتحضير التلقائي

  workDays String? // أيام العمل (مثال: الأحد-الخميس)

  // P1-CAL (9z_calendar): this table IS the WorkPattern of DOMAIN_BOUNDARIES §5.2 (owner calendar).
  // companyId = the branch's company (scope key; a trigger keeps it equal to Branch.companyId).
  // workWeekdays: the structured working days, 0 = Sunday … 6 = Saturday (empty = not set: the
  // calendar default applies); workDays stays as the label typed by HR. archivedAt: a pattern
  // referenced by an employee or an assignment period is archived, never deleted.
  companyId    String
  workWeekdays Int[]     @default([])
  archivedAt   DateTime?

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company   Company  @relation("WorkPatternCompany", fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employees         Employee[]         @relation("EmployeeWorkPattern")
  assignmentPeriods AssignmentPeriod[] @relation("AssignmentWorkPattern")

  @@index([branchId])
  @@index([companyId])
}

// P1-CAL: official and company holidays (DOMAIN_BOUNDARIES §5.2, owner calendar). One row per
// holiday, dated [startDate, endDate] inclusive, per company (DEC-PO-116: HR edits them). Eid dates
// follow the Hijri calendar and are announced each year: they are entered by HR, never invented.
model HolidayCalendar {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  kind        String    @default("COMPANY") // OFFICIAL | COMPANY (CHECK in 9z_calendar)
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  source      String? // e.g. RuleParameter:OFFICIAL_FIXED_HOLIDAYS, or null when typed by HR
  cancelledAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  company   Company @relation("HolidayCompany", fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, name, startDate])
  @@index([companyId, startDate])
}

// P1-CAL: the Ramadan period of one Hijri year for one company, and its daily working hours
// (Labor Law Art. 98 cap in RuleParameter RAMADAN_MAX_DAILY_HOURS; the company value may be lower).
model RamadanPeriod {
  id          String   @id @default(uuid())
  companyId   String
  hijriYear   Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  dailyHours  Float
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  company   Company @relation("RamadanCompany", fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("RamadanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, hijriYear])
  @@index([companyId, startDate])
}

model Department {
  id          String  @id @default(uuid())
  branchId    String
  nameArabic  String
  nameEnglish String?

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employees   Employee[]
  jobRequests JobRequest[]
  onboardingRequests OnboardingRequest[] @relation("OnboardingDepartment") // 9x_db_constraints

  assignmentPeriods AssignmentPeriod[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([branchId])
}

// ---------------------------------------------------------
// 2. Employee Profile & Onboarding
// ---------------------------------------------------------

enum ContractType {
  FULL_TIME
  PART_TIME
  FREELANCE
}

enum AccommodationType {
  OUTSIDE_COMPANY
  INSIDE_COMPANY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WPS
}

// --- ادارة الموظفين ---
model Employee {
  id          String  @id @default(uuid())
  userId      String? @unique
  employeeId  String  @unique // الرقم الوظيفي
  biometricId String? @unique // رقم أو كود تعريف جهاز البصمة

  // البيانات الأساسية
  firstNameArabic  String
  lastNameArabic   String
  firstNameEnglish String?
  lastNameEnglish  String?
  nationality      String
  dataReviewNote   String? @db.Text // بيانات ناقصة يجب على الموارد البشرية استكمالها

  iqamaOrIdNumber  String   @unique
  iqamaOrIdExp     DateTime
  iqamaRenewalCost Float?   @default(0) // تكلفة تجديد الاقامة

  passportNumber String?
  passportExp    DateTime?

  healthCertificateNum String?
  healthCertificateExp DateTime?

  dateOfBirth   DateTime
  gender        String
  maritalStatus String?

  // التواصل
  mobileNumber String?
  email        String?

  // البنك وطريقة الدفع
  ibanNumber          String?
  bankName            String?
  salaryPaymentMethod PaymentMethod @default(BANK_TRANSFER)

  // العمل والشركات
  legalCompanyId   String?
  actualCompanyId  String?
  administrationId String?
  branchId         String?
  departmentId     String?

  jobTitle        String? // المسمى الوظيفي
  jobTitleEnglish String? // المسمى بالإنجليزية (الخطابات ثنائية اللغة، docs/document-engine)
  directManagerId String? // المدير المباشر

  workSchedule      String? // جدول العمل (اسم، للعرض فقط؛ المرجع workPatternId)
  // P1-CAL: the work pattern (FK, replaces matching by name). Projection of the org assignment;
  // AssignmentPeriod.workPatternId is the fact (DOMAIN_MODEL §1.3).
  workPatternId     String?
  workPattern       WorkSchedule?      @relation("EmployeeWorkPattern", fields: [workPatternId], references: [id], onDelete: Restrict)
  accommodationType AccommodationType? // محل السكن

  // العقد والرواتب
  joinDate              DateTime // تاريخ المباشرة
  contractType          ContractType @default(FULL_TIME)
  contractEndDate       DateTime? // تاريخ انتهاء العقد
  probationEndDate      DateTime? // تاريخ انتهاء فترة التجربة
  noticePeriodDays      Int?         @default(30) // فترة الإشعار بالأيام
  leaveAccrualStartDate DateTime? // تاريخ احتساب الإجازة (يتحدث عند العودة)

  basicSalary            Float      @default(0) // الراتب الأساسي: إسقاط CompensationPeriod النافذة اليوم (يكتبه compensation فقط، ARCH-011)
  /// Projection (ARC-PAY-A4), written by compensation's projector only: the pay (and, when paid by bank,
  /// the bank identity) of the employee is applied. Existing employees start TRUE (DEC-PO-017, LEGACY_READY).
  payrollReady           Boolean    @default(false)
  gosiDeduction          Float?     @default(0) // مبلغ خصم التأمينات الاجتماعية
  gosiRegime             GosiRegime @default(UNKNOWN) // OLD: مشترك قبل 2024-07-03، NEW: النظام الجديد، UNKNOWN: يلزم تأكيد HR
  gosiRegistrationSource String? // مصدر تأكيد النظام (شهادة اشتراك، قائمة GOSI للمنشأة...)
  gosiNumber             String? // رقم الاشتراك في التأمينات
  idType                 IdType? // نوع الهوية

  isTerminated     Boolean   @default(false)
  terminationDate  DateTime?
  employmentStatus String    @default("ACTIVE") // ACTIVE, ON_LEAVE, EXCLUDED
  /// Projection of the latest non-superseded EmploymentStateChange (DEC-PO-119), written by
  /// lifecycle.transitionEmploymentState only (ARCH-005). Null until the opening (J1, P1-LCY Release B).
  employmentState  EmploymentState?

  // --- محرك القرارات (الكلفة الحقيقية والسعودة) ---
  occupationCode           String? // رمز المهنة (التصنيف السعودي الموحد للمهن)
  occupationName           String? // المهنة كما في مقيم/قوى
  dependentsCount          Int? // عدد المرافقين (من مقيم أو إدخال يدوي)
  dependentsFeePaidBy      String? // COMPANY / EMPLOYEE (رسوم المرافقين)
  isDisabled               Boolean   @default(false) // ذو إعاقة (وزن نطاقات)
  muawamaCertExpiry        DateTime? // انتهاء شهادة مواءمة
  isStudent                Boolean   @default(false) // طالب (وزن نطاقات)
  partTimeWeeklyHours      Float? // ساعات الدوام الجزئي أسبوعياً
  qiwaContractDocumented   Boolean   @default(false) // العقد موثّق في قوى
  qiwaContractDocumentedAt DateTime?
  medicalInsuranceClass    String? // فئة التأمين الطبي (VIP, A, B, C ...)
  exitReason               String? // سبب الخروج المنظّم
  exitVoluntary            Boolean? // خروج طوعي؟

  // الحضور الذاتي من البوابة (GPS + التحقق من الوجه)
  attendanceGeoExempt    Boolean @default(false) // مستثنى من شرط الموقع (ميداني) — الوجه يبقى مطلوباً
  attendanceFaceExempt   Boolean @default(false) // مستثنى من التحقق من الوجه (قرار المالك فقط) — الموقع يبقى مطلوباً
  attendanceExemptReason String? // سبب الاستثناء (إلزامي عند تفعيل أي استثناء)

  // مرفقات وثائق الموظف
  workContractUrl      String? // عقد العمل
  iqamaCopyUrl         String? // صورة الإقامة
  healthCertificateUrl String? // صورة الشهادة الصحية
  passportCopyUrl      String? // صورة الجواز
  ibanCertificateUrl   String? // شهادة الآيبان
  resumeUrl            String? // السيرة الذاتية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // العلاقات
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  directManager Employee?  @relation("ManagerToEmployee", fields: [directManagerId], references: [id])
  subordinates  Employee[] @relation("ManagerToEmployee")

  legalCompany   Company?        @relation("LegalCompany", fields: [legalCompanyId], references: [id], onDelete: SetNull)
  actualCompany  Company?        @relation("ActualCompany", fields: [actualCompanyId], references: [id], onDelete: SetNull)
  administration Administration? @relation(fields: [administrationId], references: [id], onDelete: SetNull)

  attendances            Attendance[]
  attendancePunches      AttendancePunch[]
  faceProfile            FaceProfile?
  leaves                 Leave[]
  visas                  Visa[]
  payrolls               Payroll[]
  allowances             Allowance[]
  assets                 Asset[]
  loans                  Loan[]
  telecomSims            TelecomSim[]
  vehicles               Vehicle[]
  settlements            Settlement[]
  overtimeRequests       OvertimeRequest[]
  workAssignments        WorkAssignment[]
  attendanceCorrections  AttendanceCorrection[]
  deductions             Deduction[]
  jobRequestsMade        JobRequest[]           @relation("RequesterToJobRequest")
  terminationRequests    TerminationRequest[]
  evaluations            EmployeeEvaluation[]
  transferRequests       TransferRequest[]
  investigations         Investigation[]
  onboardingRequestsMade OnboardingRequest[]    @relation("RequesterToOnboarding")
  assetRequestsMade      AssetRequest[]         @relation("RequesterToAssetRequest")
  assetRequestsFor       AssetRequest[]         @relation("RequestedForToAssetRequest")
  salaryChanges          SalaryChange[]

  documentRequests DocumentRequest[]
  issuedDocuments  IssuedDocument[]
  circularRecipients CircularRecipient[]

  // Effective periods (P1-FND-EFF): written through src/modules/platform/effective only (ARCH-012).
  employmentPeriods         EmploymentPeriod[]
  employmentStateChanges    EmploymentStateChange[]
  employmentMigrationReviews EmploymentMigrationReview[] // 9zd_lcy_tables
  settlementEffects         SettlementEffect[]           // 9zd_lcy_tables
  paymentsReceived          PaymentRequest[]             @relation("PaymentBeneficiary") // 9zf_payroll_gateway
  compensationPeriods       CompensationPeriod[]
  bankIdentityPeriods       BankIdentityPeriod[]      // 9zg_financial_change (P1-PAY-B)
  financialChanges          EmployeeFinancialChange[] // 9zg_financial_change (P1-PAY-B)
  userLinks                 UserEmployeeLink[]        // 9zk_identity_controls (BL-PAY-005)
  assignmentPeriods         AssignmentPeriod[]   @relation("AssignmentEmployee")
  managedAssignmentPeriods  AssignmentPeriod[]   @relation("AssignmentManager")
  // back-relations of the foreign keys added by 9x_db_constraints (P1-FND-DB)
  transferRequestsRaised    TransferRequest[]    @relation("TransferRequester")
  overtimesSupervised       OvertimeRequest[]    @relation("OvertimeSupervisor")
  workAssignmentsSupervised WorkAssignment[]     @relation("WorkAssignmentSupervisor")
  evaluationsAsManager      EmployeeEvaluation[] @relation("EvaluationManager")
  muqeemTransactions        MuqeemTransaction[]  @relation("MuqeemTransactionEmployee")
  onboardingsAsManager      OnboardingRequest[]  @relation("OnboardingDirectManager")

  @@index([legalCompanyId])
  @@index([actualCompanyId])
  @@index([administrationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([directManagerId])
  @@index([workPatternId])
  @@index([isTerminated, employmentStatus])
  @@index([employmentState, terminationDate])
  @@index([iqamaOrIdExp])
  @@index([passportExp])
  @@index([healthCertificateExp])
  @@index([contractEndDate])
}

// --- طلبات النقل الداخلي ---
model TransferRequest {
  id          String  @id @default(uuid())
  employeeId  String
  requesterId String? // المدير الذي رفع الطلب

  fromBranchId   String?
  toBranchId     String
  toWorkSchedule String? // جدول العمل الجديد

  reason      String? // سبب النقل
  assetAction String? @default("RETAIN") // RETAIN أو CLEAR

  status String  @default("PENDING") // PENDING, APPROVED, REJECTED
  hrNote String? // ملاحظة الموارد البشرية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requester  Employee? @relation("TransferRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  fromBranch Branch?   @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch    @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------
// 3. Documents
// ---------------------------------------------------------

// ---------------------------------------------------------
// 4. Time & Attendance
// ---------------------------------------------------------

// --- محفظة الدوام والحضور ---
model Attendance {
  id            String    @id @default(uuid())
  employeeId    String
  date          DateTime  @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        String    @default("PRESENT")
  lateMinutes   Int       @default(0)
  earlyMinutes  Int       @default(0)
  earlyLeaveMin Int       @default(0) // keeping this for back-compatibility
  overtimeMin   Int       @default(0)

  /// Origin of each punch: MANUAL (HR entry) | CORRECTION (approved request) | SELF (portal GPS + face). null = before 6_self_attendance.
  checkInSource  String?
  checkOutSource String?
  /// A self punch was accepted with a warning (borderline face / liveness score) and awaits review.
  flagged        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  punches  AttendancePunch[]

  @@unique([employeeId, date])
  @@index([date])
}

enum PunchType {
  IN
  OUT
}

enum PunchResult {
  ACCEPTED
  FLAGGED
  REJECTED
}

// --- مواقع الحضور الذاتي: نطاق دائري (مركز + نصف قطر) لكل موقع، وقد يكون للفرع أكثر من موقع ---
model AttendanceLocation {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @default(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  punches AttendancePunch[] // 9x_db_constraints

  @@index([branchId])
}

// --- القالب المرجعي لوجه الموظف (بيانات حيوية حساسة: مشفرة، وتُحذف عند انتهاء الخدمة أو سحب الموافقة) ---
model FaceProfile {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  /// encryptField(JSON array of the face-service embedding). Never sent to the client.
  embedding       String   @db.Text
  /// Model that produced the embedding (e.g. sface_2021dec): a model change requires re-enrollment.
  model           String
  /// Reference selfie under UPLOAD_DIR/.biometric/ (not reachable through /api/files).
  photoStoredName String?
  consentAt       DateTime
  consentVersion  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// --- كل محاولة حضور/انصراف ذاتي (مقبولة أو مشبوهة أو مرفوضة): الدليل وسجل المراجعة ---
model AttendancePunch {
  id           String      @id @default(uuid())
  employeeId   String
  /// Attendance row written by an accepted / flagged punch (null for rejected ones).
  attendanceId String?
  /// Work day the punch belongs to (date-only, Riyadh). For overnight shifts it can be the previous day.
  workDate     DateTime    @db.Date
  type         PunchType
  result       PunchResult
  /// Reason codes (src/lib/self-attendance.ts PUNCH_REASONS).
  reasons      String[]

  latitude     Float?
  longitude    Float?
  accuracyM    Float?
  distanceM    Float?
  /// Snapshot of the matched / nearest location at punch time.
  locationId   String?
  locationName String?
  radiusM      Int?

  faceScore        Float?
  livenessScore    Float?
  /// Selfie kept only for REJECTED / FLAGGED punches, under UPLOAD_DIR/.biometric/, purged after the retention period.
  selfieStoredName String?
  selfiePurgedAt   DateTime?

  reviewedAt   DateTime?
  reviewedById String?

  ipAddress String?
  userAgent String?
  /// Server time of the punch: the only trusted clock.
  createdAt DateTime @default(now())

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendance  Attendance?            @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  location    AttendanceLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reviewedBy  User?                  @relation("PunchReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  corrections AttendanceCorrection[]

  @@index([employeeId, createdAt])
  @@index([result, createdAt])
  @@index([workDate])
  @@index([attendanceId])
}

// ---------------------------------------------------------
// 5. Leaves & Visas
// ---------------------------------------------------------

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum LeaveType {
  ANNUAL // سنوية
  DEDUCTED // مستقطعة من الرصيد السنوي
  SICK // مرضية
  EMERGENCY // طارئة
  UNPAID // بدون أجر
  MATERNITY // وضع
  PATERNITY // مولود للأب
  BEREAVEMENT // وفاة قريب
  MARRIAGE // زواج
  HAJJ // حج
}

// --- ادارة الاجازات ---
model Leave {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  LeaveType   @default(ANNUAL)
  startDate  DateTime
  endDate    DateTime
  totalDays  Int
  status     LeaveStatus @default(PENDING)
  notes      String?

  // --- مسار الموافقات (Approval Workflow) ---
  isManagerApproved Boolean   @default(false)
  managerApprovedAt DateTime?
  isHrApproved      Boolean   @default(false)
  hrApprovedAt      DateTime?

  // الرصيد
  availableBalance Float? // رصيد الإجازة المتاح وقت الطلب
  paidDays         Int? // الأيام المدفوعة (من الرصيد)
  unpaidDays       Int? // الأيام الإضافية بدون أجر

  // الخصومات
  dailyDeductionRate Float? @default(30) // تكلفة اليوم الإضافي (900/30 = 30 ر.س/يوم)
  totalDeduction     Float? // إجمالي الخصم على الموظف

  // هل الإجازة خارج المملكة
  isOutsideKSA        Boolean @default(false)
  exitReentryVisaCost Float?  @default(0) // تأشيرة خروج وعودة (200 ر.س)

  // تذكرة الطيران
  flightTicketOption String? // "company_provided" أو "amount"
  flightTicketAmount Float? // مبلغ التذكرة إن وجد

  // أيام العمل حتى بداية الإجازة (للطارئة)
  workingDaysBeforeLeave Int?

  // العودة وتمديد الإجازة
  isReturned       Boolean   @default(false)
  actualReturnDate DateTime?
  extensionFileUrl String?
  extensionReason  String?

  createdAt DateTime @default(now())
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId, status])
  @@index([status])
  @@index([startDate, endDate])
}

enum VisaStatus {
  PENDING_PAYMENT // بانتظار الدفع
  PAID // تم الدفع
  ISSUED // تم الاصدار
  CANCELLED // أُلغيت (مثلاً عند إلغاء الإجازة)
}

// --- ادارة التاشيرات ---
model Visa {
  id         String     @id @default(uuid())
  employeeId String
  visaType   String // خروج وعودة، خروج نهائي
  status     VisaStatus @default(PENDING_PAYMENT)

  deductedFrom  String? // خصم من اجازة او تصفية
  attachmentUrl String? // مرفق أو رابط الإيصال

  // حقول حجز تذكرة الطيران
  ticketStatus        String? // BOOKED, PENDING
  airline             String? // شركة الطيران
  bookingRef          String? // رقم الحجز
  flightFrom          String? // من (المدينة)
  flightTo            String? // إلى (المدينة)
  departureDate       DateTime? // تاريخ المغادرة
  returnDate          DateTime? // تاريخ العودة
  ticketAttachmentUrl String? // مرفق تذكرة الطيران
  // --- بيانات التأشيرة الرسمية (مقيم) ---
  externalVisaNumber  String? // رقم التأشيرة في مقيم
  visaDurationDays    Int? // مدة التأشيرة بالأيام
  returnBefore        DateTime? // العودة قبل (ميلادي)
  visaPdfUrl          String?   @db.Text // نسخة التأشيرة PDF
  issuedViaMuqeemAt   DateTime? // تاريخ الإصدار عبر مقيم

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------
// 6. Payroll, Allowances & Loans
// ---------------------------------------------------------

model Allowance {
  id               String   @id @default(uuid())
  employeeId       String
  name             String
  amount           Float
  isMonthly        Boolean  @default(true)
  countsTowardGosi Boolean  @default(false) // يدخل في وعاء اشتراك التأمينات (مثل بدل السكن)
  allowanceType    String? // HOUSING / TRANSPORT / FOOD / OTHER (فارغ = يُستنتج من الاسم)
  // المكافآت لمرة واحدة (isMonthly=false) تُصرف في مسير شهر محدد ثم تُعلَّم مصروفة
  payrollMonth     Int?
  payrollYear      Int?
  isPaid           Boolean  @default(false)
  paidInPayrollId  String?
  /// P1-PAY-A (9zf, BR-PAY-003): PENDING | APPROVED | REJECTED (CHECK Allowance_status_check). Existing rows
  /// APPROVED; the default goes when BL-PAY-007 makes new bonuses and allowances PENDING.
  status           String   @default("APPROVED")
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  paidInPayroll    Payroll? @relation("AllowancePaidInPayroll", fields: [paidInPayrollId], references: [id], onDelete: Restrict)
  createdBy        User?    @relation("AllowanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy       User?    @relation("AllowanceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([payrollYear, payrollMonth])
  @@index([paidInPayrollId])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

// --- مسير الرواتب وتصفية المستحقات ---
model Payroll {
  id         String @id @default(uuid())
  employeeId String
  month      Int
  year       Int

  basicSalary     Float
  totalAllowances Float @default(0)
  totalDeductions Float @default(0)
  overtimeCost    Float @default(0)

  netSalary           Float
  gosiEmployee        Float   @default(0) // حصة الموظف في التأمينات
  gosiEmployer        Float   @default(0) // حصة صاحب العمل (تكلفة، لا تُخصم من الموظف)
  loansDeduction      Float   @default(0)
  violationsDeduction Float   @default(0)
  leaveDeduction      Float   @default(0)
  otherDeductions     Float   @default(0)
  bonusAmount         Float   @default(0)
  // تفصيل البدلات المتكررة وقت توليد المسيّر (قسيمة الراتب). null = مسيّر وُلّد قبل التفصيل
  housingAllowance    Float?
  transportAllowance  Float?
  otherAllowances     Float?
  needsReview         Boolean @default(false) // سطر يحتاج مراجعة (مثلاً نظام التأمينات غير مؤكد)
  reviewNote          String?

  status PayrollStatus @default(DRAFT)
  paidAt DateTime?

  isFinalSettlement Boolean @default(false)
  settlementReason  String?

  /// P1-PAY-A (9zf): the legal company of the line and its month (ARC-PAY-A7). NULL only on legacy rows
  /// the migration could not resolve (RAISE NOTICE; CHECK Payroll_companyId_required refuses new ones).
  companyId      String?
  payrollMonthId String?
  /// Who triggered payroll.generate (SYSTEM operation), who approved, who recorded the payment (BR-PAY-006).
  generatedById  String?
  approvedById   String?
  approvedAt     DateTime?
  paidById       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company          Company?          @relation("PayrollCompany", fields: [companyId], references: [id], onDelete: Restrict)
  payrollMonth     PayrollMonth?     @relation(fields: [payrollMonthId], references: [id], onDelete: Restrict)
  generatedBy      User?             @relation("PayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  approvedBy       User?             @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy           User?             @relation("PayrollPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  loanInstallments LoanInstallment[]
  paidAllowances   Allowance[]       @relation("AllowancePaidInPayroll") // 9x_db_constraints
  paidOvertimes    OvertimeRequest[] @relation("OvertimePaidInPayroll") // 9x_db_constraints

  // One line per employee and month stays until BL-PAY-008b prorates a mid-month transfer by
  // AssignmentPeriod (a second company's line would pay the month twice); the design key is the next one.
  @@unique([employeeId, month, year])
  @@unique([payrollMonthId, employeeId])
  @@index([year, month])
  @@index([status])
  @@index([companyId, year, month])
}

/// kind: FACT (after approval) - the payroll of one legal company for one month (ARC-PAY-A7,
/// LIFECYCLE_MODEL §2.3). Sole writer: src/modules/payroll/transitions (behind money.gateway).
/// status: DRAFT, CALCULATED, APPROVED, PAID (LINES_APPROVED / EXPORTED / PAYMENT_EXCEPTION arrive with
/// BL-PAY-008b / 020); CHECK PayrollMonth_status_check.
model PayrollMonth {
  id             String    @id @default(uuid())
  companyId      String
  year           Int
  month          Int
  status         String    @default("DRAFT")
  /// Optimistic version: every transition moves it (guarded updateMany, LIFECYCLE_MODEL §2.2).
  version        Int       @default(0)
  calculatedAt   DateTime?
  calculatedById String?
  approvedAt     DateTime?
  approvedById   String?
  paidAt         DateTime?
  paidById       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company   @relation("PayrollMonthCompany", fields: [companyId], references: [id], onDelete: Restrict)
  calculatedBy User?     @relation("PayrollMonthCalculatedBy", fields: [calculatedById], references: [id], onDelete: Restrict)
  approvedBy   User?     @relation("PayrollMonthApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy       User?     @relation("PayrollMonthPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  lines        Payroll[]

  @@unique([companyId, year, month])
  @@index([year, month])
  @@index([status])
}

// ==========================================
// --- الإدارة القانونية: السندات لأمر ---
// ==========================================

model PromissoryNote {
  id     String @id @default(uuid())
  amount Float // مبلغ السند النقدية

  // P1-SCOPE (9zb): scope key (DOMAIN_BOUNDARIES §5.4.3); NULL = unknown, visible to unrestricted users only
  companyId String?
  company   Company? @relation("PromissoryNoteCompany", fields: [companyId], references: [id], onDelete: Restrict)

  // أطراف السند
  creditorName String // اسم الدائن (المستفيد)
  debtorName   String // اسم المدين (محرر السند المتعهد بالدفع)

  // صفة الشركة (هل الشركة هي الدائن أم المدين؟)
  companyRole String @default("CREDITOR") // CREDITOR, DEBTOR

  // تفاصيل الاستحقاق (متى يدفع؟)
  isOnDemand Boolean   @default(false) // مستحق لدى الاطلاع (بدون تاريخ)
  dueDate    DateTime? // تاريخ الاستحقاق (في حال لم يكن لدى الاطلاع)

  notes String? // ملاحظات ومبررات السند

  // مسارات المرفقات والأوراق الرسمية الواردة
  idAttachment    String? // صورة الهوية
  noteAttachment  String? // أصل السند المكتوب
  otherAttachment String? // ملفات أخرى

  // حالة السند الجارية والسداد
  status            String    @default("ACTIVE") // ACTIVE (فعال), PAID (مسدد), CANCELLED (ملغي)
  paymentAttachment String? // مرفق التحويل أو السداد
  paymentDate       DateTime? // تاريخ استلام أو دفع المبلغ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([companyId])
}

// ==========================================
// --- الإدارة القانونية: العقود والاتفاقيات ---
// ==========================================

model LegalContract {
  id    String @id @default(uuid())
  title String // مسمى أو موضوع العقد

  // P1-SCOPE (9zb): scope key (DOMAIN_BOUNDARIES §5.4.3); NULL = unknown, visible to unrestricted users only
  companyId String?
  company   Company? @relation("LegalContractCompany", fields: [companyId], references: [id], onDelete: Restrict)

  // أطراف العقد
  firstParty  String // الطرف الأول (غالبًا الشركة)
  secondParty String // الطرف الثاني (مورد، مقاول، عميل...)

  // تفاصيل التواريخ
  startDate DateTime // تاريخ بداية العقد
  endDate   DateTime? // تاريخ نهايته أو تجديده

  notes String? // بنود مختصرة أو ملاحظات

  // المرفقات
  contractAttachment String? // ملف العقد الموثق والمتفق عليه
  otherAttachment    String? // مستندات مساندة (سجل تجاري للطرف الآخر، تفويض..)

  status String @default("ACTIVE") // ACTIVE (معتمد وساري), EXPIRED (منتهي), TERMINATED (مفسوخ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([companyId])
}

// ==========================================
// --- الإدارة القانونية: المنازعات القضائية ---
// ==========================================

model Lawsuit {
  id String @id @default(uuid())

  // P1-SCOPE (9zb): scope key (DOMAIN_BOUNDARIES §5.4.3); NULL = unknown, visible to unrestricted users only
  companyId String?
  company   Company? @relation("LawsuitCompany", fields: [companyId], references: [id], onDelete: Restrict)

  // التصنيف
  caseType String // LABOR (عمالية), COMMERCIAL (تجارية), REAL_ESTATE (عقارية), OTHER (أخرى)

  // أطراف الدعوى
  plaintiff String // المدعي
  defendant String // المدعى عليه

  // الموضوع
  subject String // تفاصيل وموضوع النزاع باختصار

  // حالة الدعوى والمكتب المفوض
  status         String  @default("REFERRED") // REFERRED (تمت الإحالة للمكتب), CLOSED (تم الانتهاء وإغلاقها)
  lawFirmName    String? // المكتب المحامي المفوض بالدعوى
  lawFirmContact String? // رقم التواصل للمكتب

  judgmentAttachment String? // إرفاق صك الحكم أو قرار الدائرة

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([companyId])
}

// --- طلبات العمل الإضافي (الأوفرتايم) ---
model OvertimeRequest {
  id                 String   @id @default(uuid())
  employeeId         String
  supervisorId       String? // المشرف الذي رفع الطلب
  date               DateTime // تاريخ العمل الاضافي أو التكليف
  type               String   @default("HOURS") // HOURS, LUMP_SUM, BIOMETRIC
  hours              Float?   @default(0) // عدد الساعات 
  amount             Float?   @default(0) // مبلغ مقطوع
  reason             String? // السبب
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  paidInPayrollId    String? // المسير الذي صُرف فيه
  paidInSettlementId String? // التصفية التي صُرف فيها
  /// P1-PAY-A (9zf, BR-PAY-006): who filed / assigned it and who decided it.
  createdById        String?
  decidedById        String?
  decidedAt          DateTime?
  createdBy          User?   @relation("OvertimeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy          User?   @relation("OvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supervisor       Employee?   @relation("OvertimeSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  paidInPayroll    Payroll?    @relation("OvertimePaidInPayroll", fields: [paidInPayrollId], references: [id], onDelete: Restrict)
  paidInSettlement Settlement? @relation("OvertimePaidInSettlement", fields: [paidInSettlementId], references: [id], onDelete: Restrict)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@index([paidInPayrollId])
}

// --- تكاليف المهام الخارجية (انتداب / عمل خارجي) ---
model WorkAssignment {
  id           String   @id @default(uuid())
  employeeId   String
  supervisorId String? // المشرف أو المدير المباشر
  destination  String // الجهة
  details      String // كتابة التفاصيل
  startDate    DateTime // تاريخ البداية
  endDate      DateTime // تاريخ النهاية

  // سلسلة الموافقات
  status String @default("PENDING_EMPLOYEE") // PENDING_EMPLOYEE, PENDING_HR, APPROVED, REJECTED

  employeeApprovedAt DateTime?
  hrApprovedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supervisor Employee? @relation("WorkAssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

// --- الخصومات والمخالفات (نظام متقدم) ---
model Deduction {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  amount     Float
  reason     String // سبب الخصم (تأخير، مخالفة، الخ)
  status     String   @default("DEDUCTED")
  // DEDUCTED, PENDING_AMOUNT_APPROVAL, PENDING_WAIVE_APPROVAL, WAIVED,
  // PENDING_INVESTIGATION, UNDER_INVESTIGATION, OBJECTION_SUBMITTED, OBJECTION_REJECTED

  // --- نظام تصنيف المخالفات ---
  category         String? @default("ATTENDANCE") // ATTENDANCE, BEHAVIORAL, SERIOUS, PERFORMANCE
  violationType    String? // النوع الفرعي للمخالفة
  occurrenceNumber Int?    @default(1) // رقم تكرار المخالفة
  severity         String? @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  lawArticle       String? // رقم أو نص المادة النظامية

  // --- إحالة للتحقيق ---
  isReferredToInvestigation Boolean @default(false)
  investigationId           String? // ربط بملف التحقيق

  // --- اعتراض الموظف ---
  hasObjection    Boolean   @default(false)
  objectionText   String? // نص اعتراض الموظف
  objectionDate   DateTime?
  objectionStatus String? // PENDING, ACCEPTED, REJECTED

  // --- الأثر المالي والربط بالرواتب ---
  hasFinancialImpact Boolean @default(true)
  deductionDays      Int?    @default(0) // عدد أيام الخصم (0 = إنذار فقط)
  dailySalary        Float? // الراتب اليومي المحتسب
  isLinkedToPayroll  Boolean @default(false) // هل تم ربطه بمسير الراتب
  payrollMonth       String? // شهر المسير المرتبط (مثلاً: 2026-04)
  /// BL-PAY-030 (9zi): the latest payroll month whose generation offered this deduction but could not fit it
  /// whole (it was not reserved, nor linked on approval); it stays due for the next generated month. null = never deferred.
  deferredPayrollMonth String?

  // --- مسار الاعتماد ---
  issuedBy   String? // من أصدر المخالفة (اسم أو ID)
  approvedBy String? // من اعتمدها
  approvedAt DateTime?
  /// P1-PAY-A (9zf, BR-PAY-006): the users behind issuedBy / approvedBy (the names stay for display).
  issuedById   String?
  decidedById  String?
  issuedByUser User?   @relation("DeductionIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  decidedBy    User?   @relation("DeductionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  createdAt     DateTime       @default(now())
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  investigation Investigation? @relation(fields: [investigationId], references: [id])
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([employeeId, date])
  @@index([investigationId])
  @@index([status])
  @@index([payrollMonth])
}

// --- التحقيقات الإدارية (الإدارة القانونية) ---
model Investigation {
  id String @id @default(uuid())

  // الموظف المحال للتحقيق
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // تفاصيل التحقيق
  subject     String // موضوع التحقيق
  description String? // وصف تفصيلي
  category    String? // ATTENDANCE, BEHAVIORAL, SERIOUS, PERFORMANCE
  severity    String  @default("HIGH") // HIGH, CRITICAL

  // حالة التحقيق
  status String @default("OPENED")
  // OPENED (تم الفتح), IN_PROGRESS (جاري التحقيق), 
  // COMPLETED_GUILTY (ثبتت الإدانة), COMPLETED_INNOCENT (ثبتت البراءة), 
  // CLOSED (مغلق), SUSPENDED (موقوف مؤقتاً)

  // نتائج التحقيق
  findings       String? // نتائج التحقيق
  recommendation String? // التوصية (إنذار، فصل، إحالة...)
  finalDecision  String? // القرار النهائي

  // الأثر المالي
  penaltyAmount Float? // قيمة الجزاء المالي إن وجد
  penaltyDays   Int? // عدد أيام الخصم

  // إيقاف عن العمل
  isSuspended         Boolean   @default(false)
  suspensionStartDate DateTime?
  suspensionEndDate   DateTime?

  // المحقق المسؤول
  investigatorName String? // اسم المحقق
  investigatorRole String? // منصب المحقق

  // المرفقات والسجل
  attachmentUrl String? // مرفقات التحقيق

  // الملاحظات
  notes String?

  // المخالفات المرتبطة
  deductions Deduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// --- ادارة السلف ---
model Loan {
  id                 String  @id @default(uuid())
  employeeId         String
  amount             Float
  reason             String?
  monthlyInstallment Float

  remainingAmount Float
  isForgiven      Boolean @default(false)

  // --- حالة الطلب ومسار الموافقات ---
  status String @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, FINANCE_APPROVED, REJECTED

  isManagerApproved Boolean   @default(false)
  managerApprovedAt DateTime?

  isHrApproved Boolean   @default(false)
  hrApprovedAt DateTime?

  isFinanceApproved Boolean   @default(false)
  financeApprovedAt DateTime?

  receiptUrl           String? // إيصال تحويل المالية
  isFinanceTransferred Boolean   @default(false)
  financeTransferredAt DateTime?

  /// P1-PAY-A (9zf, BR-PAY-006 / BR-PAY-017): the person of every stage. Legacy rows keep NULL (BR-PAY-015).
  createdById         String?
  managerApprovedById String?
  hrApprovedById      String?
  ownerApprovedById   String?
  transferredById     String?
  financeReviewedById String?
  forgivenById        String?
  rejectedById        String?
  rejectedAt          DateTime?
  createdBy           User?     @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  managerApprovedBy   User?     @relation("LoanManagerApprovedBy", fields: [managerApprovedById], references: [id], onDelete: Restrict)
  hrApprovedBy        User?     @relation("LoanHrApprovedBy", fields: [hrApprovedById], references: [id], onDelete: Restrict)
  ownerApprovedBy     User?     @relation("LoanOwnerApprovedBy", fields: [ownerApprovedById], references: [id], onDelete: Restrict)
  transferredBy       User?     @relation("LoanTransferredBy", fields: [transferredById], references: [id], onDelete: Restrict)
  financeReviewedBy   User?     @relation("LoanFinanceReviewedBy", fields: [financeReviewedById], references: [id], onDelete: Restrict)
  forgivenBy          User?     @relation("LoanForgivenBy", fields: [forgivenById], references: [id], onDelete: Restrict)
  rejectedBy          User?     @relation("LoanRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  createdAt    DateTime          @default(now())
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  installments LoanInstallment[]
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
}

// --- أقساط السلف المخصومة في مسيرات الرواتب ---
model LoanInstallment {
  id        String   @id @default(uuid())
  loanId    String
  payrollId String?
  month     Int
  year      Int
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Restrict)
  payroll   Payroll? @relation(fields: [payrollId], references: [id], onDelete: SetNull)

  @@unique([loanId, month, year])
  @@index([payrollId])
  @@index([year, month])
}

// ---------------------------------------------------------
// 7. Compliance & Government Violations
// ---------------------------------------------------------
model ComplianceViolation {
  id String @id @default(uuid())

  // Relation to Entity (Either Company or Branch)
  companyId String?
  branchId  String?

  authority String // جهة المخالفة (مكتب العمل، التجارة، البلدية...)
  amount    Float // قيمة المخالفة

  correctivePeriod Int? // فترة السماح للتصحيح (أيام)
  canObject        Boolean @default(false) // قابلة للاعتراض

  status String  @default("PENDING_PAYMENT") // PENDING_PAYMENT, CORRECTED, PAID
  notes  String? // تفاصيل المخالفة

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

model AttendanceCorrection {
  id             String   @id @default(uuid())
  employeeId     String
  date           DateTime
  reason         String
  correctionType String?  @default("GENERAL") // LATE, EARLY_LEAVE, ABSENT, GENERAL
  attachmentUrl  String?  @db.Text

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  // مسار الموافقات
  isManagerApproved Boolean   @default(false)
  managerApprovedAt DateTime?
  managerComment    String?

  isHrApproved Boolean   @default(false)
  hrApprovedAt DateTime?
  hrComment    String?

  /// Rejected / flagged self punch this request is about: on approval its SERVER time fills the
  /// missing punch (instead of the scheduled time), so a deliberately failed punch cannot erase lateness.
  punchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  punch    AttendancePunch? @relation(fields: [punchId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([punchId])
}

// ---------------------------------------------------------
// 3. مسير الرواتب (Payrolls)، السلف والتصفيات
// ---------------------------------------------------------
// 8. Recruitment Management (إدارة التوظيف)
// ---------------------------------------------------------
model JobRequest {
  id String @id @default(uuid())

  departmentId String? // القسم الطالب للوظيفة
  requesterId  String // المدير الذي رفع الطلب
  // مفتاح نطاق الشركة (ARC-ONB-A4، BL-ONB-012): شركة فرع القسم. قابل للفراغ ولا FK في المرحلة 0؛ الإلزام والمفتاح الأجنبي في P1-FND-DB
  companyId    String?

  jobTitle    String // المسمى الوظيفي
  jobType     String // كامل، جزئي، عن بعد
  nationality String // الجنسية المطلوبة أو "غير محدد"
  description String // المهام والوصف
  status      String @default("PENDING") // PENDING (معلق), APPROVED (موافق عليه), REJECTED (مرفوض), FULFILLED (تم التوظيف)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester    Employee         @relation("RequesterToJobRequest", fields: [requesterId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  company      Company?         @relation("JobRequestCompany", fields: [companyId], references: [id], onDelete: Restrict)
  applications JobApplication[]

  @@index([departmentId])
  @@index([requesterId])
  @@index([status])
  @@index([companyId])
}

model JobApplication {
  id String @id @default(uuid())

  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  candidateName  String // اسم المرشح
  candidatePhone String // هاتف المرشح
  candidateEmail String? // ايميل المرشح
  resumeUrl      String? // رابط السيرة الذاتية 

  status        String    @default("APPLIED") // APPLIED (تحت الفرز), INTERVIEW (مقابلة), OFFERED (عرض وظيفي), HIRED (تم التوظيف), REJECTED (مرفوض)
  documentRequests DocumentRequest[]
  issuedDocuments  IssuedDocument[]
  onboardingRequests OnboardingRequest[] @relation("OnboardingJobApplication") // 9x_db_constraints
  interviewDate DateTime? // موعد المقابلة إن وجد
  notes         String? // ملاحظات التقييم أو العرض المالي

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobRequestId])
  @@index([status])
  @@index([jobRequestId, candidatePhone])
}

// --- طلبات المباشرة الجديدة (Onboarding) ---
model OnboardingRequest {
  id          String @id @default(uuid())
  requesterId String // المدير الذي رفع الطلب
  // مفتاح نطاق الشركة (ARC-ONB-A4، BL-ONB-012): الشركة النظامية للموظف الجديد (عند الرفع تُشتق من الفرع، وعند الاعتماد ما اعتمدته HR).
  // قابل للفراغ ولا FK في المرحلة 0؛ الإلزام والمفتاحان الأجنبيان (Restrict) في P1-FND-DB
  companyId        String?
  jobApplicationId String? // المرشح الذي قُبل عرضه (onb-to-be §17)؛ يُملأ من مسار العرض (BL-ONB-004)

  // البيانات الشخصية للموظف
  fullNameArabic   String
  lastNameArabic   String?
  firstNameEnglish String?
  lastNameEnglish  String?
  nationality      String?
  dateOfBirth      DateTime?
  gender           String?
  maritalStatus    String?

  // الهوية والجواز
  iqamaOrIdNumber String
  iqamaOrIdExp    DateTime?
  passportNumber  String?
  passportExp     DateTime?

  // التواصل
  mobileNumber String
  email        String?

  // التعيين والعمل
  branchId         String?
  administrationId String?
  departmentId     String?
  directManagerId  String?
  jobTitle         String?
  joinDate         DateTime?
  contractType     String?

  // المالية
  bankName    String?
  ibanNumber  String?
  basicSalary Float?

  // المرفقات
  iqamaCopyUrl         String?
  passportCopyUrl      String?
  ibanCertificateUrl   String?
  resumeUrl            String?
  workContractUrl      String?
  healthCertificateUrl String?

  status String  @default("PENDING") // PENDING, APPROVED, REJECTED
  hrNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester Employee @relation("RequesterToOnboarding", fields: [requesterId], references: [id], onDelete: Cascade)
  company        Company?        @relation("OnboardingCompany", fields: [companyId], references: [id], onDelete: Restrict)
  jobApplication JobApplication? @relation("OnboardingJobApplication", fields: [jobApplicationId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation("OnboardingBranch", fields: [branchId], references: [id], onDelete: SetNull)
  administration Administration? @relation("OnboardingAdministration", fields: [administrationId], references: [id], onDelete: SetNull)
  department     Department?     @relation("OnboardingDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  directManager  Employee?       @relation("OnboardingDirectManager", fields: [directManagerId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([status])
  @@index([companyId])
  @@index([jobApplicationId])
}

// ---------------------------------------------------------
// 9. Assets / Custody
// ---------------------------------------------------------

// --- ادارة العهد ---
model Asset {
  id          String    @id @default(uuid())
  employeeId  String?
  assetType   String // سيارة، كمبيوتر
  description String?
  receiveDate DateTime?
  returnDate  DateTime?
  status      String    @default("ACTIVE") // ACTIVE, RETURNED, DAMAGED, TRANSFERRED

  // P1-SCOPE (9zb): owning company (DOMAIN_BOUNDARIES §5.4.3 assets). A vacant asset keeps it; an
  // insert without it takes the holder's legal company (trigger asset_default_company, 9zb).
  companyId String?
  company   Company? @relation("AssetCompany", fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([companyId])
}

// ---------------------------------------------------------
// 10. Medical Insurance (إدارة التأمين الطبي)
// ---------------------------------------------------------

model MedicalInsurance {
  id        String @id @default(uuid())
  companyId String // يربط المنشأة (Company) المرتبطة بالتأمين

  insuranceIssuer String // اسم شركة التأمين
  policyNumber    String // رقم الوثيقة
  policyCost      Float // تكلفة الوثيقة
  expiryDate      DateTime // تاريخ انتهاء الوثيقة

  // حقول إضافية للموظفين
  medicalNetwork String? // الشبكة الطبية (مثل: VIP، A، B، C)
  coverageType   String? // نوع التغطية (فردي، عائلي، أفراد+عائلة)
  insuranceClass String? // فئة التأمين (Gold، Silver، Bronze)

  benefitsUrl String? @db.Text // ملف بطاقات وتفاصيل المنافع
  coverageUrl String? @db.Text // ملف التغطية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiryDate])
}

// ---------------------------------------------------------
// 8. Services & Vehicles
// ---------------------------------------------------------

// --- شرائح الجوال والانترنت ---
model TelecomSim {
  id            String  @id @default(uuid())
  simNumber     String // رقم الشريحة
  accountNumber String? // رقم السداد
  provider      String? // مزود الخدمة
  plan          String? // الباقة
  serviceType   String? // نوع الخدمة (جوال، ارضي، نت، الياف)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([employeeId])
}

// --- عدادات الكهرباء والمياه ---
model UtilityMeter {
  id            String  @id @default(uuid())
  meterCode     String? // كود العداد تلقائي
  meterNumber   String? // رقم العداد
  accountNumber String? // رقم السداد
  meterPhotoUrl String? // صور العداد (مرفق)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  legalCompanyId String?
  legalCompany   Company? @relation("LegalMeterOwner", fields: [legalCompanyId], references: [id], onDelete: SetNull)

  actualCompanyId String?
  actualCompany   Company? @relation("ActualMeterUser", fields: [actualCompanyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@index([legalCompanyId])
  @@index([actualCompanyId])
}

// --- ادارة المركبات (اللوجستي) ---
model Vehicle {
  id             String  @id @default(uuid())
  vehicleCode    String? // كود السيارة تلقائي
  category       String // الفئة: خصوصي / نقل خاص / نقل عام
  brand          String // النوع: كيا، هونداي...
  modelYear      String // الموديل
  color          String // اللون
  sequenceNumber String // الرقم التسلسلي
  plateNumber    String // رقم اللوحة

  // المالك القانوني
  legalCompanyId String?
  legalCompany   Company? @relation("LegalVehicleOwner", fields: [legalCompanyId], references: [id], onDelete: SetNull)

  // المستفيد الفعلي
  actualCompanyId String?
  actualCompany   Company? @relation("ActualVehicleUser", fields: [actualCompanyId], references: [id], onDelete: SetNull)

  // التواريخ والتكاليف
  licenseExpDate       DateTime? // تاريخ انتهاء رخصة السير
  insuranceExpDate     DateTime? // تاريخ انتهاء التأمين
  insuranceCost        Float?    @default(0) // مبلغ وثيقة التأمين للمركبة
  inspectionExpDate    DateTime? // تاريخ انتهاء الفحص
  operatingCardExpDate DateTime? // تاريخ انتهاء كارت التشغيل
  operatingCardUrl     String? // مرفق كارت التشغيل

  // السائق
  driverId          String?
  driver            Employee? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverCardNumber  String? // بطاقة السائق
  driverCardExpDate DateTime? // تاريخ انتهاء بطاقة السائق

  // المرفقات
  drivingAuthorizationUrl String? // تفويض القيادة
  drivingAuthExpDate      DateTime? // تاريخ انتهاء التفويض
  vehiclePhotosUrl        String? // صور المركبة
  registrationFormUrl     String? // الاستمارة
  otherAttachmentsUrl     String? // أخرى

  isArchived Boolean @default(false)

  createdAt DateTime        @default(now())
  claims    AccidentClaim[]
  updatedAt DateTime        @default(now()) @updatedAt

  @@index([legalCompanyId])
  @@index([actualCompanyId])
  @@index([driverId])
  @@index([isArchived])
  @@index([licenseExpDate])
  @@index([insuranceExpDate])
  @@index([inspectionExpDate])
  @@index([operatingCardExpDate])
  @@index([driverCardExpDate])
  @@index([drivingAuthExpDate])
}

// --- حالات المطالبة ---
enum ClaimStatus {
  PENDING_SUBMISSION // بانتظار تقديم المطالبة
  SUBMITTED // تم تقديم المطالبة
  TRANSFERRED // تم التحويل
}

// --- مطالبات الحوادث ---
model AccidentClaim {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // تفاصيل المطالبة
  faultPercentageAgainst Float? // نسبة الخطأ على الشركة
  faultPercentageFor     Float? // نسبة الخطأ لصالح الشركة
  claimAmount            Float? // مبلغ المطالبة
  insuranceCompany       String? // شركة التأمين المسؤولة
  status                 ClaimStatus @default(PENDING_SUBMISSION)

  // المرفقات
  najmReportUrl       String? // تقرير نجم
  estimatesUrl        String? // التقديرات
  accidentPhotosUrl   String? // صور السيارة
  ibanUrl             String? // الايبان
  otherAttachmentsUrl String? // أخرى

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

// --- نوع التصفية ---
enum SettlementType {
  LEAVE_SETTLEMENT // تصفية بغرض الاجازة
  END_OF_SERVICE // تصفية بغرض انتهاء الخدمة
}

// --- سبب انهاء العقد ---
enum TerminationReason {
  COMPANY_TERMINATION // إنهاء من قبل الشركة (عادي)
  RESIGNATION // استقالة
  PROBATION // إنهاء بموجب فترة التجربة
  ARTICLE_80 // إنهاء على المادة 80
  ARTICLE_81 // ترك العمل لإخلال صاحب العمل (المادة 81)
  ARTICLE_87 // حالات المادة 87 (قوة قاهرة، الزواج/الوضع للعاملة)
  CONTRACT_EXPIRY // انتهاء العقد محدد المدة
}

// --- تصفية مستحقات الموظفين ---
model Settlement {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  paidOvertimes OvertimeRequest[] @relation("OvertimePaidInSettlement") // 9x_db_constraints

  type              SettlementType
  terminationReason TerminationReason?

  // حقول الاحتساب
  salaryBasis        String? // basic أو total
  lastWorkingDate    DateTime? // آخر يوم عمل
  workingDaysInMonth Int? // عدد أيام العمل خلال الشهر
  workingDaysSalary  Float? // راتب أيام العمل

  // نهاية الخدمة
  yearsOfService     Float? // سنوات الخدمة
  endOfServiceAmount Float? // مبلغ نهاية الخدمة

  // بدل الاجازة
  unusedLeaveDays   Float? // أيام الإجازة غير المستخدمة
  leaveCompensation Float? // بدل الاجازة السنوية
  /// BL-PAY-027 (9zh): leave days this settlement pays (leaveDaysToPay at creation). Payroll excludes them
  /// by this count, never by leaveCompensation / today's daily rate. NULL = legacy row (former formula).
  leavePaidDays     Float?

  // إضافات وخصومات
  additionalEntitlements Float?  @default(0)
  additionalDeductions   Float?  @default(0)
  additionalNotes        String? // ملاحظات

  // الإجمالي
  totalSettlement Float? // صافي التصفية
  loansDeduction  Float? // خصم السلف المحتسب عند إنشاء التصفية
  overtimeAmount  Float? // عمل إضافي مستحق مدرج في التصفية

  // الحالة
  status             String  @default("PENDING_APPROVAL") // PENDING_APPROVAL, OWNER_APPROVED, PAID, REJECTED
  transferReceiptUrl String? // إيصال التحويل
  // إثبات الصرف، تسجله المالية عند تأكيده (أساس المخالصة في بيان التسوية)
  paymentMethod      String? // BANK_TRANSFER | CASH_VOUCHER | CHEQUE
  paymentReference   String? // رقم التحويل أو سند الصرف أو الشيك
  paidAt             DateTime? // تاريخ الصرف الفعلي
  ownerNotes         String? // سبب الرفض أو ملاحظات صاحب العمل
  /// P1-PAY-A (9zf, BR-PAY-012): HR creator, owner approver, finance payer (three different people).
  createdById        String?
  approvedById       String?
  approvedAt         DateTime?
  paidById           String?
  createdBy          User?   @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?   @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy             User?   @relation("SettlementPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  /// BL-LCY-015 effect log of the owner approval (SettlementEffect, 9zd; replaced the approvalEffects column).
  effects            SettlementEffect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------
// 9. Renewals & Archives
// ---------------------------------------------------------

enum RenewalAction {
  RENEWED
  TERMINATED
  PENDING_PAYMENT
}

model RenewalArchive {
  id           String @id @default(uuid())
  entityType   String // "EMPLOYEE", "BRANCH", "COMPANY", "VEHICLE"
  entityId     String // ID of the entity
  documentType String // "IQAMA", "PASSPORT", "RENT_CONTRACT", etc.

  action RenewalAction // "RENEWED" أو "TERMINATED"

  oldExpDate DateTime? // تاريخ الانتهاء القديم
  newExpDate DateTime? // تاريخ الانتهاء الجديد (في حال التجديد)

  attachmentUrl String? // مرفق التجديد أو الانتهاء
  notes         String? // ملاحظات الانتهاء

  createdAt DateTime @default(now())

  @@index([entityId, documentType])
  @@index([action, documentType])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------
// 10. System Settings (إعدادات النظام)
// ---------------------------------------------------------
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // مفتاح الإعداد
  value     String // قيمة الإعداد (JSON string)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 12. Employee Portal Requests (طلبات بوابة الموظف)
// ---------------------------------------------------------
model TerminationRequest {
  id         String @id @default(uuid())
  employeeId String

  terminationType String // END_OF_CONTRACT, RESIGNATION, MUTUAL_AGREEMENT
  reasonDetails   String? @db.Text
  lastWorkingDate DateTime? // آخر يوم عمل، يحدده HR عند الاعتماد (يُطبع في خطاب الموافقة)

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  // --- مسار الموافقات ---
  isManagerApproved Boolean   @default(false)
  managerApprovedAt DateTime?
  isHrApproved      Boolean   @default(false)
  hrApprovedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

// ==========================================
// --- الإدارة القانونية: الوكالات الموثقة ---
// ==========================================

model CertifiedAgency {
  id           String @id @default(uuid())
  agencyNumber String // رقم الوكالة

  // P1-SCOPE (9zb): scope key (DOMAIN_BOUNDARIES §5.4.3); NULL = unknown, visible to unrestricted users only
  companyId String?
  company   Company? @relation("CertifiedAgencyCompany", fields: [companyId], references: [id], onDelete: Restrict)

  // الأطراف
  principalName String // اسم الموكل
  principalId   String // هوية الموكل
  agentName     String // اسم الوكيل
  agentId       String // هوية الوكيل

  // التواريخ
  startDate DateTime // تاريخ بداية الوكالة
  endDate   DateTime // تاريخ الانتهاء

  // المرفقات
  attachmentUrl String? // مرفق الوكالة

  status String @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([companyId])
}

// ==========================================
// --- الإدارة المالية: المدفوعات والاعتمادات ---
// ==========================================

enum PaymentStatus {
  PENDING_OWNER // بانتظار اعتماد صاحب العمل
  PENDING_FINANCE // بانتظار الدفع (للمالية)
  PAID // تم التحويل والسداد
  COMPLETED // تم التأكيد والإقفال
  RETURNED // مسترجع من المالية (لم يتم السداد) أو مرفوض
}

model PaymentRequest {
  id String @id @default(uuid())

  title         String // اسم السداد
  reason        String? // السبب
  amount        Float // المبلغ المستحق
  accountNumber String? // رقم الحساب أو المفوتر

  status       PaymentStatus @default(PENDING_OWNER)
  receiptUrl   String? // إيصال أو صورة التحويل من قبل المحاسب
  returnReason String? // سبب الاسترجاع (مثلاً: انتهاء صلاحية رقم السداد)

  // لربط الدفعة بكيان معين في التجديدات أو غيرها
  entityId      String?
  entityType    String?
  documentType  String?
  requestedById String? // منشئ الطلب
  approvedById  String? // معتمد الطلب (لا يساوي المنشئ)
  paidById      String? // مسجِّل الدفع
  /// P1-PAY-A (9zf, §17): the employee the money goes to (cache of the linked record; BR-PAY-001).
  beneficiaryEmployeeId String?
  approvedAt            DateTime?
  paidAt                DateTime?
  beneficiary           Employee? @relation("PaymentBeneficiary", fields: [beneficiaryEmployeeId], references: [id], onDelete: Restrict)

  requestedBy User? @relation("PaymentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy      User? @relation("PaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entityId, documentType])
  @@index([entityType, entityId])
}

// ==========================================
// --- بوابة صاحب العمل والتعاميم ---
// ==========================================

model Circular {
  id            String   @id @default(uuid())
  title         String // عنوان القرار أو التعميم
  content       String // تفاصيل القرار
  issuedBy      String // مُصدر القرار (عادة صاحب العمل أو المدير العام)
  status        String   @default("PUBLISHED") // أو DRAFT
  attachmentUrl String? // اختياري، صورة للقرار
  datePublished DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([status, datePublished])
}

model OwnerRequest {
  id            String   @id @default(uuid())
  title         String // عنوان الطلب 
  details       String // تفاصيل التوجيه أو الطلب
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  assignedTo    String? // موجه إلى (قسم أو شخص)
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// ==========================================
// --- نظام تقييم الأداء ---
// ==========================================

// --- نموذج التقييم (القالب) ---
model EvaluationTemplate {
  id          String   @id @default(uuid())
  name        String // اسم النموذج
  description String? // وصف النموذج
  targetType  String   @default("GENERAL") // GENERAL, OPERATIONAL, LEADERSHIP, CUSTOM
  evalType    String   @default("QUARTERLY") // MONTHLY, QUARTERLY, ANNUAL, PROBATION
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections EvaluationTemplateSection[]
  cycles   EvaluationCycle[]
}

// --- محاور التقييم ---
model EvaluationTemplateSection {
  id         String   @id @default(uuid())
  templateId String
  title      String // مثل: الأداء الوظيفي
  weight     Float // الوزن النسبي (مثل 40)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  template  EvaluationTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items     EvaluationTemplateItem[]
  updatedAt DateTime                 @default(now()) @updatedAt

  @@index([templateId])
}

// --- عناصر كل محور ---
model EvaluationTemplateItem {
  id          String   @id @default(uuid())
  sectionId   String
  title       String // مثل: إنجاز المهام المطلوبة
  description String? // شرح اختياري
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  section   EvaluationTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  scores    EvaluationItemScore[]
  updatedAt DateTime                  @default(now()) @updatedAt

  @@index([sectionId])
}

// --- دورات التقييم ---
model EvaluationCycle {
  id         String   @id @default(uuid())
  title      String // مثل: تقييم الربع الأول 2026
  templateId String
  cycleType  String   @default("QUARTERLY") // MONTHLY, QUARTERLY, ANNUAL, PROBATION
  startDate  DateTime
  endDate    DateTime
  status     String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  createdBy  String? // من أنشأ الدورة
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template    EvaluationTemplate   @relation(fields: [templateId], references: [id])
  evaluations EmployeeEvaluation[]

  @@index([templateId])
  @@index([status])
}

// --- تقييمات الموظفين ---
model EmployeeEvaluation {
  id         String  @id @default(uuid())
  cycleId    String
  employeeId String
  managerId  String? // المدير المباشر المُقيّم

  status String @default("DRAFT")
  // DRAFT, PENDING_MANAGER, PENDING_APPROVAL, RETURNED, PENDING_EMPLOYEE_ACK, CLOSED, CANCELLED

  totalScore  Float? // النتيجة النهائية من 100
  finalRating String? // ممتاز، جيد جداً، جيد، مقبول، ضعيف

  // التوصيات
  recommendation       String? // NO_ACTION, BONUS, PROMOTION, RAISE, TRAINING, WARNING, NOTICE, EXTEND_MONITORING, NO_RENEWAL, TERMINATION, OTHER
  recommendationReason String? // سبب التوصية

  // الملاحظات النصية
  strengths    String? @db.Text // نقاط القوة
  improvements String? @db.Text // نقاط التحسين
  finalNotes   String? @db.Text // ملاحظات ختامية (إلزامي)

  // إقرار الموظف
  employeeAcknowledgedAt DateTime?
  employeeComment        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle      EvaluationCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  manager    Employee?             @relation("EvaluationManager", fields: [managerId], references: [id], onDelete: Restrict)
  itemScores EvaluationItemScore[]
  approvals  EvaluationApproval[]

  @@index([cycleId])
  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@index([employeeId, status])
}

// --- درجات عناصر التقييم ---
model EvaluationItemScore {
  id           String  @id @default(uuid())
  evaluationId String
  itemId       String
  score        Int     @default(0) // 1-5
  note         String? // ملاحظة اختيارية على العنصر

  evaluation EmployeeEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  item       EvaluationTemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt

  @@index([evaluationId])
  @@index([itemId])
}

// --- سجل الاعتمادات ---
model EvaluationApproval {
  id           String   @id @default(uuid())
  evaluationId String
  approverId   String? // من قام بالإجراء
  approverName String? // اسم المعتمد
  action       String // APPROVE, RETURN, REJECT
  comment      String?  @db.Text
  actionDate   DateTime @default(now())

  evaluation EmployeeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  approver   User?              @relation("EvaluationApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
}

// ---------------------------------------------------------
// إدارة المنصات الحكومية
// ---------------------------------------------------------
model GovPlatform {
  id               String  @id @default(uuid())
  platformName     String // اسم المنصة (مثال: أبشر، مقيم، قوى، إلخ)
  username         String // اسم المستخدم
  password         String // كلمة المرور
  phoneNumber      String? // رقم الجوال المرتبط
  authorizedPerson String? // اسم الشخص المفوض
  notes            String? @db.Text // ملاحظات إضافية

  // P1-SCOPE (9zb): the company whose credentials these are (DOMAIN_BOUNDARIES §5.4.3 gov, EV-5021).
  // NULL = unknown (legacy row not derivable), visible to unrestricted users only.
  companyId String?
  company   Company? @relation("GovPlatformCompany", fields: [companyId], references: [id], onDelete: Restrict)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  muqeemCompanies Company[] @relation("CompanyMuqeemPlatform")

  @@index([companyId])
}

// ---------------------------------------------------------
// 13. Asset Needs Requests (طلبات احتياج العهد)
// ---------------------------------------------------------
model AssetRequest {
  id             String  @id @default(uuid())
  requesterId    String
  requestedForId String
  assetType      String // لابتوب، جوال، شريحة، أخرى
  description    String? @db.Text

  status String @default("PENDING_HR")
  // PENDING_HR (بانتظار الموارد البشرية)
  // PENDING_OWNER (بانتظار تعميد صاحب العمل)
  // PENDING_PURCHASING (بانتظار مسؤول المشتريات)
  // COMPLETED (تم التسليم والإقفال)
  // REJECTED (مرفوض)

  hrNotes      String?   @db.Text
  hrApprovedAt DateTime?

  ownerNotes      String?   @db.Text
  ownerApprovedAt DateTime?

  purchasingNotes String?   @db.Text
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester    Employee @relation("RequesterToAssetRequest", fields: [requesterId], references: [id], onDelete: Cascade)
  requestedFor Employee @relation("RequestedForToAssetRequest", fields: [requestedForId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([requestedForId])
  @@index([status])
}

// --- سجل الملفات المرفوعة (للتحقق من صلاحية الوصول) ---
model UploadedFile {
  id           String   @id @default(uuid())
  storedName   String   @unique // الاسم المخزن في UPLOAD_DIR
  originalName String?
  mimeType     String?
  size         Int?
  isPublic     Boolean  @default(false) // رُفع بدون جلسة (طلب توظيف)
  uploadedById String?
  employeeId   String? // الموظف المالك (إن وُجد)
  category     String? // IDENTITY, PASSPORT, HEALTH, BANK, CONTRACT, OTHER
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@index([employeeId])
}

enum GosiRegime {
  OLD // مشترك قبل نفاذ النظام الجديد (2024-07-03)
  NEW // يخضع لنظام التأمينات الجديد
  UNKNOWN // لم يُؤكد بعد
}

enum IdType {
  NATIONAL_ID
  IQAMA
  BORDER_NUMBER
  PASSPORT
}

// --- جدول معدلات التأمينات المؤرخ (يُحدَّث بالترحيلات) ---
model GosiRate {
  id            String     @id @default(uuid())
  regime        GosiRegime // OLD / NEW (صفوف غير السعوديين تستخدم OLD)
  isSaudi       Boolean
  effectiveFrom DateTime // تاريخ السريان (بداية اليوم)
  employeeRate  Float // نسبة مئوية، مثال 9.75
  employerRate  Float
  minWage       Float      @default(1500)
  maxWage       Float      @default(45000)
  isProvisional Boolean    @default(false) // بانتظار تأكيد مستشار/مصدر رسمي
  source        String?
  createdAt     DateTime   @default(now())

  @@unique([regime, isSaudi, effectiveFrom])
}

// --- سجل تشغيل المهام الخلفية ---
model JobRun {
  id         String    @id @default(uuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING, SUCCEEDED, FAILED
  details    String?   @db.Text

  @@index([job, startedAt])
}

// --- صندوق الإشعارات الصادرة (Outbox) ---
model NotificationOutbox {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  channel        String // EMAIL, WHATSAPP, SMS, IN_APP
  recipient      String
  subject        String?
  body           String    @db.Text
  status         String    @default("PENDING") // PENDING, SENDING, SENT, FAILED, UNKNOWN
  attempts       Int       @default(0)
  leaseUntil     DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
}

// --- معاملات مقيم (سجل وحماية من التنفيذ المزدوج) ---
model MuqeemTransaction {
  id              String    @id @default(uuid())
  idempotencyKey  String    @unique // يمنع تكرار نفس العملية على نفس الكيان
  operation       String // EXIT_REENTRY_ISSUE, IQAMA_RENEW, FINAL_EXIT_ISSUE, ...
  status          String    @default("PENDING") // PENDING, SUCCEEDED, FAILED, UNKNOWN
  companyId       String?
  employeeId      String?
  entityType      String? // VISA, EMPLOYEE, SETTLEMENT
  entityId        String?
  externalRef     String? // رقم التأشيرة / رقم البلاغ ...
  httpStatus      Int?
  errorMessage    String?   @db.Text
  requestSummary  String?   @db.Text // ملخص الطلب بلا بيانات حساسة
  responseSummary String?   @db.Text
  documentUrl     String?   @db.Text // ملف PDF المُرجع (إن وجد)
  requestedById   String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  company     Company?  @relation("MuqeemTransactionCompany", fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee? @relation("MuqeemTransactionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy User?     @relation("MuqeemTransactionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([entityType, entityId])
  @@index([status])
}

// --- محرك القرارات: سجل القواعد المؤرخة بمصادرها ---
model RuleParameter {
  id            String    @id @default(uuid())
  key           String // مثال: EXPAT_LEVY_ABOVE_SAUDI_COUNT
  domain        String // GOSI, LABOR_LAW, EXPAT_FEES, NITAQAT, HRDF, ...
  label         String // الاسم العربي
  value         Float?
  valueJson     String?   @db.Text // قيم مركّبة (جداول)
  unit          String? // SAR_MONTH, SAR_YEAR, PERCENT, DAYS, HOURS ...
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String // VERIFIED_PRIMARY, CORROBORATED_SECONDARY, PROVISIONAL, CONFLICTING, USER_INPUT
  sourceUrl     String?   @db.Text
  sourceQuote   String?   @db.Text
  notes         String?   @db.Text
  verifiedAt    DateTime?
  verifiedBy    String?
  createdById   String?
  createdAt     DateTime  @default(now())
  createdBy     User?     @relation("RuleParameterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([key, effectiveFrom])
  @@index([domain])
}

// تجاوز الشركة لقيمة نظامية (P1-RULE): مؤرخ [effectiveFrom, effectiveTo)، ضمن الحد القانوني لكل مفتاح
// (src/modules/rules/catalogue.ts). الكاتب الوحيد: src/modules/rules/transitions.ts. القارئ: rules.valueAt.
model CompanyRuleOverride {
  id            String    @id @default(uuid())
  companyId     String
  key           String
  value         Float
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  reason        String    @db.Text
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  revokedAt     DateTime?
  revokedById   String?
  /// DEC-PO-126 (9ze): acknowledgement of a value outside the legal bound (below a MIN / above a MAX)
  belowLegalAckAt      DateTime?
  belowLegalAckById    String?
  belowLegalReason     String?   @db.Text
  /// The legal value the override departs from, at acknowledgement
  belowLegalLegalValue Float?
  company       Company   @relation("RuleOverrideCompany", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key, effectiveFrom])
  @@index([companyId, key])
}

// افتراضات المنشأة التي لا تنشرها جهة رسمية (أقساط التأمين، كلفة التوظيف، سياسات الرسوم...)
model WorkforceAssumption {
  id          String   @id @default(uuid())
  key         String
  companyId   String   @default("") // "" = لكل الشركات
  value       Float?
  valueJson   String?  @db.Text
  note        String?  @db.Text
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  updatedBy   User?    @relation("WorkforceAssumptionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([key, companyId])
}

// لقطة لكل حساب محفوظ: لماذا ظهر هذا الرقم في هذا اليوم؟
model WorkforceCalculation {
  id            String   @id @default(uuid())
  kind          String // TRUE_COST, EXIT_COST, OVERVIEW
  subjectType   String? // EMPLOYEE, COMPANY, BRANCH, DEPARTMENT, ALL
  subjectId     String?
  title         String?
  engineVersion String
  ruleVersions  String   @db.Text // JSON: key -> effectiveFrom/status
  inputs        String   @db.Text // JSON
  outputs       String   @db.Text // JSON
  createdById   String?
  createdAt     DateTime @default(now())
  createdBy     User?    @relation("WorkforceCalculationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([kind, createdAt])
  @@index([subjectType, subjectId])
}

// سجل تغييرات الراتب المؤرخ (للزيادات المخططة والفعلية)
model SalaryChange {
  id            String   @id @default(uuid())
  employeeId    String
  effectiveDate DateTime
  basicSalary   Float
  reason        String?
  isPlanned     Boolean  @default(false) // مخطط (سيناريو) أم مطبّق فعلاً
  createdById   String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy     User?    @relation("SalaryChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate])
}

// --- محرك القرارات (المرحلة 2): نطاقات المطوّر 2026 وقرارات توطين المهن ---
// ---------------------------------------------------------------------------
// محرك إصدار المستندات (docs/document-engine: ADR-001 + SPEC §4.3)
// ثبات السجلات (DOC-07 / DOC-09 / DOC-12) تحميه triggers في الترحيل 9b_document_engine،
// فهي خارج هذا الملف. العزل بين العملاء بنيوي (DEC-004): لا tenantId.
// ---------------------------------------------------------------------------

/// هوية الشركة النظامية على مستنداتها. الاسم والسجل والرقم الموحد تُقرأ من Company نفسها.
model BrandProfile {
  id           String   @id @default(uuid())
  companyId    String   @unique
  numberPrefix String // 2-6 أحرف لاتينية كبيرة: ACM ← ACM-SAL-2026-000184 (ثابتة بعد أول إصدار)
  logoAssetId  String?
  primaryColor String   @default("#0F4C81")
  numerals     String   @default("latn") // latn | arab (أرقام المبالغ والتواريخ)
  addressAr    String?
  addressEn    String?
  phone        String?
  email        String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// شعار أو توقيع أو ختم. ثابت بعنوان محتواه: التغيير أصل جديد، ولا يُحذف ما استُخدم (DOC-04).
model DocumentAsset {
  id          String   @id @default(uuid())
  companyId   String
  kind        String // LOGO | SIGNATURE | STAMP
  sha256      String
  storedName  String // <UPLOAD_DIR>/.document-assets/<sha256>.png (shared file when two companies upload the same bytes)
  size        Int
  width       Int
  height      Int
  createdById String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sha256])
  @@index([companyId, kind])
}

model Signatory {
  id               String   @id @default(uuid())
  companyId        String
  userId           String? // إن كان له حساب: يعتمد بنفسه ويقبل التفويض
  nameAr           String
  nameEn           String?
  titleAr          String
  titleEn          String?
  signatureAssetId String?
  stampAssetId     String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorizations SigningAuthorization[]

  @@index([companyId, isActive])
}

/// تفويض مسبق صريح ومقيد وقابل للإلغاء (DOC-04). لا يُعدَّل إلا بالقبول أو الإلغاء، ولا يُحذف.
model SigningAuthorization {
  id             String    @id @default(uuid())
  signatoryId    String
  legalCompanyId String
  typeKey        String
  scopeJson      String?   @db.Text // مثل {"maxTotalSalary":"30000.00"}
  validFrom      DateTime
  validUntil     DateTime?
  grantedById    String
  grantedAt      DateTime  @default(now())
  acceptedAt     DateTime? // قبول الموقّع نفسه؛ بدونه لا يسري إن كان له حساب
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?

  signatory Signatory @relation(fields: [signatoryId], references: [id], onDelete: Restrict)

  @@index([signatoryId, typeKey, legalCompanyId])
}

/// سياسة النوع لكل شركة. الحقول الفارغة = افتراضي النوع في الكود.
model DocumentTypeSetting {
  id               String   @id @default(uuid())
  companyId        String
  typeKey          String
  enabled          Boolean  @default(true)
  selfService      Boolean?
  requiresApproval Boolean?
  validityDays     Int?
  signatoryId      String?
  optionsJson      String? // خيارات النوع للشركة (مثل السماح بالنقل لمدينة أخرى بقرار)، JSON من مفاتيح DocumentTypeDefinition.options
  updatedById      String?
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, typeKey])
}

model DocumentRequest {
  id                String    @id @default(uuid())
  typeKey           String
  legalCompanyId    String // مشتقة من employee.legalCompanyId، لا يختارها المستخدم (DOC-03)؛ للمرشح يختارها HR ضمن نطاقه
  employeeId        String? // صاحب المستند: موظف، أو
  jobApplicationId  String? // مرشح (العرض الوظيفي). واحد منهما بالضبط (CHECK في الترحيل 9k)
  requestedById     String?
  source            String // PORTAL | HR | SYSTEM
  sourceRef         String? // مصدر طلب النظام، مثل settlement:<id> (لا يتكرر لنفس النوع)
  paramsJson        String    @db.Text
  status            String // DRAFT | PENDING_APPROVAL | APPROVED | ISSUED | REJECTED | CANCELLED (DOC-08)
  currentSnapshotId String?   @unique
  rejectReason      String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee        Employee?          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobApplication  JobApplication?    @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  legalCompany    Company            @relation(fields: [legalCompanyId], references: [id], onDelete: Restrict)
  currentSnapshot DocumentSnapshot?  @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Restrict)
  snapshots       DocumentSnapshot[] @relation("RequestSnapshots")
  approvals       DocumentApproval[]
  renderJob       DocumentRenderJob?
  issuedDocument  IssuedDocument?

  @@unique([typeKey, sourceRef])
  @@index([status, createdAt])
  @@index([employeeId, createdAt])
  @@index([jobApplicationId])
  @@index([legalCompanyId, status])
}

/// لقطة ثابتة للبيانات الجوهرية بصيغة JSON قانونية (JCS)؛ النص نفسه هو ما تُحسب بصمته.
model DocumentSnapshot {
  id              String    @id @default(uuid())
  requestId       String
  typeKey         String
  contractVersion Int
  data            String    @db.Text
  dataSha256      String
  brand           String    @db.Text // قيم الهوية وقت اللقطة (ليست جوهرية، DOC-05)
  purgedAt        DateTime? // انتهاء مدة الاحتفاظ (DOC-09): تُمسح data وbrand
  createdAt       DateTime  @default(now())

  request        DocumentRequest  @relation("RequestSnapshots", fields: [requestId], references: [id], onDelete: Restrict)
  currentFor     DocumentRequest? @relation("CurrentSnapshot")
  issuedDocument IssuedDocument?

  @@index([requestId])
}

model DocumentApproval {
  id             String    @id @default(uuid())
  requestId      String
  snapshotId     String
  snapshotSha256 String // المعتمد يعتمد ما رآه (DOC-05)
  approverId     String
  decision       String // APPROVED | REJECTED
  note           String?
  decidedAt      DateTime  @default(now())
  invalidatedAt  DateTime?
  invalidReason  String? // STALE_SNAPSHOT

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// معالجة تقنية فقط (DOC-08). الرقم ولحظة الإصدار يُحجزان هنا ولا يتغيران عبر المحاولات (DOC-02).
model DocumentRenderJob {
  id              String   @id @default(uuid())
  requestId       String   @unique
  legalCompanyId  String
  typeCode        String
  year            Int
  seq             Int
  number          String
  issuedAt        DateTime // = creationTimestamp للتصيير: نفس البايتات عند إعادة المحاولة
  verifyTokenHash String   @unique
  verifyTokenEnc  String? // الرمز مشفراً (encryptField) حتى ينجح التصيير، ثم يُمسح
  signatoryId     String?
  authorizationId String?
  approvalId      String?
  status          String   @default("QUEUED") // QUEUED | RENDERING | FAILED | DONE
  attempts        Int      @default(0)
  lastError       String?
  nextAttemptAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([legalCompanyId, number])
  @@index([status, nextAttemptAt])
}

/// المستند الصادر. يُنشأ بعد وجود البايتات وبصمتها فقط. لا يتغير بعد الإنشاء إلا الإلغاء
/// والاستبدال وعلامة انتهاء الاحتفاظ (trigger، DOC-07).
model IssuedDocument {
  id              String    @id @default(uuid())
  number          String
  legalCompanyId  String
  employeeId       String?
  jobApplicationId String?
  typeKey         String
  requestId       String    @unique
  snapshotId      String    @unique
  snapshotSha256  String
  approvalId      String?
  signatoryId     String?
  authorizationId String?
  templateRef     String
  templateSha256  String
  rendererId      String
  rendererVersion String
  typstSha256     String
  fontsSha256     String
  pdfStandard     String
  storedName      String    @unique // <UPLOAD_DIR>/.documents/<storedName>
  pdfSha256       String
  pdfSize         Int
  verifyTokenHash String    @unique
  validUntil      DateTime?
  issuedAt        DateTime
  issuedById      String?
  status          String    @default("ISSUED") // ISSUED | REVOKED | SUPERSEDED (لا EXPIRED، DOC-08)
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  supersededById  String?   @unique
  purgedAt        DateTime? // انتهاء مدة الاحتفاظ: حُذف الملف، وبقي هذا السجل (DOC-09)
  createdAt       DateTime  @default(now())
  sealKeyId        String? // مفتاح الختم الرقمي PAdES (null: صدر قبل تفعيل الختم)

  employee        Employee?                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobApplication  JobApplication?          @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  legalCompany Company          @relation(fields: [legalCompanyId], references: [id], onDelete: Restrict)
  request      DocumentRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  snapshot     DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  acknowledgement DocumentAcknowledgement?
  candidateAccess CandidateDocumentAccess?
  recipients      CircularRecipient[] // تعميم أو قرار إداري: الموظفون الموجه إليهم
  sealKey         DocumentSealKey?         @relation(fields: [sealKeyId], references: [id], onDelete: Restrict)

  @@unique([legalCompanyId, number])
  @@index([employeeId, issuedAt])
  @@index([jobApplicationId])
  @@index([status])
  @@index([sealKeyId])
}

/// مفتاح الختم الرقمي للشركة النظامية وشهادته الذاتية (قرار المالك 2026-09-27، الترحيل 9m). المفتاح الخاص
/// مشفّر بـDATA_ENCRYPTION_KEY. لا يُحذف ولا يُعدَّل، ويُتقاعد مرة واحدة؛ مفتاح واحد ساري لكل شركة (فهرس جزئي في الترحيل)
model DocumentSealKey {
  id          String    @id @default(uuid())
  companyId   String
  certDer     Bytes // الشهادة X.509 بصيغة DER (عامة، تُنزَّل من صفحة التحقق)
  keyEnc      String    @db.Text // المفتاح الخاص PKCS#8 PEM مشفراً (src/lib/crypto.ts)
  fingerprint String    @unique // SHA-256 للشهادة
  serialHex   String
  notBefore   DateTime
  notAfter    DateTime
  createdById String?
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  documents IssuedDocument[]

  @@index([companyId])
}

/// إقرار الموظف باستلام مستند (الإنذار): صف واحد لا يُعدَّل، والتعليق يُمسح فقط عند انتهاء مدة الاحتفاظ
model DocumentAcknowledgement {
  id             String   @id @default(uuid())
  documentId     String   @unique
  employeeId     String? // null: رد مرشح عبر رابط العرض
  userId         String? // null: رد عبر رابط (بلا حساب)
  decision       String   @default("RECEIVED") // RECEIVED (استلام) | ACCEPTED (موافقة/قبول) | DISPUTED (اعتراض) | DECLINED (رفض العرض)
  via            String   @default("PORTAL") // PORTAL | LINK
  comment        String?  @db.Text
  acknowledgedAt DateTime @default(now())

  document IssuedDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

/// نص تختاره الشركة يُطبع قبل النص الأساسي لنوع مستند (OPENING) أو بعده (CLOSING). صفوف لا تُعدَّل:
/// كل تعديل صف جديد، والساري أحدثها لكل (شركة، نوع، موضع)، والنص الفارغ يعني الإزالة
model DocumentTextOverride {
  id          String   @id @default(uuid())
  companyId   String
  typeKey     String
  slot        String // OPENING | CLOSING
  textAr      String?  @db.Text
  textEn      String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, typeKey, slot, createdAt])
}

/// المستلم لقرار إداري أو تعميم (الترحيل 9o): التوزيع ثابت عند الإصدار، والتغيير الوحيد إقراره بالاطلاع مرة واحدة
model CircularRecipient {
  id               String    @id @default(uuid())
  documentId       String
  employeeId       String
  acknowledgedAt   DateTime?
  acknowledgedById String?
  createdAt        DateTime  @default(now())

  document IssuedDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([documentId, employeeId])
  @@index([employeeId])
}

/// رابط المرشح إلى عرضه الوظيفي: رمز سري (يُخزن هاشه ونسخة مشفرة لنسخه لـHR) ينتهي بانتهاء صلاحية العرض
model CandidateDocumentAccess {
  id         String   @id @default(uuid())
  documentId String   @unique
  tokenHash  String   @unique
  tokenEnc   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  document IssuedDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
}

/// أمر تنفيذ قرار ترقية أو زيادة (PROMOTION_DECISION): يُطبَّق على ملف الموظف في تاريخ السريان مرة واحدة
model EmployeeChangeOrder {
  id              String    @id @default(uuid())
  employeeId      String
  documentId      String    @unique // القرار الصادر الذي أنشأه
  effectiveDate   DateTime
  basicSalary     Float? // الراتب الأساسي الجديد (null = بلا تغيير)
  jobTitle        String? // المسمى الجديد (null = بلا تغيير)
  jobTitleEnglish String?
  // ملحق العقد (الترحيل 9n): بدل السكن والنقل الشهريان، ومكان العمل (الفرع)، وتاريخ انتهاء العقد (null = بلا تغيير)
  housingAllowance   Float?
  transportAllowance Float?
  branchId           String?
  contractEndDate    DateTime?
  // قرار النقل (الترحيل 9p): الإدارة والمدير المباشر الجديدان (null = بلا تغيير)
  departmentId       String?
  directManagerId    String?
  appliedAt       DateTime?
  cancelledAt     DateTime? // أُلغي القرار قبل سريانه
  createdAt       DateTime  @default(now())

  @@index([appliedAt, cancelledAt, effectiveDate])
  @@index([employeeId])
}

model DocumentCounter {
  legalCompanyId String
  typeCode       String
  year           Int
  next           Int    @default(1)

  @@id([legalCompanyId, typeCode, year])
}

/// سجل إلحاق فقط بسلسلة بصمات (UPDATE/DELETE مرفوضان بـtrigger).
model DocumentEvent {
  id         String   @id @default(uuid())
  seq        BigInt   @unique @default(autoincrement())
  requestId  String?
  documentId String?
  type       String
  actorId    String?
  ip         String?
  metaJson   String?  @db.Text
  prevHash   String
  hash       String
  at         DateTime @default(now())

  @@index([documentId])
  @@index([requestId])
}

// أنشطة نطاقات كما في ملحق الدليل الإجرائي الرسمي، مع مصدر كل صف وحالته.
model NitaqatActivity {
  key         String         @id // مفتاح ثابت (slug)
  nameAr      String // اسم النشاط كما في الملحق
  code        String? // رمز النشاط إن وُجد
  sizeSegment String? // شريحة الحجم إن كان الملحق يقسّم النشاط حسب الحجم
  status      String // VERIFIED_PRIMARY, AMBIGUOUS, PROVISIONAL, USER_INPUT
  sourceUrl   String?        @db.Text
  page        Int?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  curves      NitaqatCurve[]
}

// ثوابت المنحنى: الحد الأدنى للنطاق Y = m·ln(X) + c لكل نشاط ونطاق وسنة.
model NitaqatCurve {
  id          String          @id @default(uuid())
  activityKey String
  band        String // LOW_GREEN, MEDIUM_GREEN, HIGH_GREEN, PLATINUM
  year        Int
  m           Float
  c           Float
  status      String // VERIFIED_PRIMARY, AMBIGUOUS, PROVISIONAL, USER_INPUT
  sourceUrl   String?         @db.Text
  page        Int?
  note        String?         @db.Text
  createdById String?
  createdAt   DateTime        @default(now())
  activity    NitaqatActivity @relation(fields: [activityKey], references: [key], onDelete: Cascade)
  createdBy   User?           @relation("NitaqatCurveCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([activityKey, band, year])
}

// قرارات توطين المهن (نسبة ومراحل وحد أدنى للأجر وحجم المنشأة)
model LocalizationDecision {
  id                   String    @id @default(uuid())
  groupNameAr          String // مثال: مهن المحاسبة
  occupationsJson      String    @db.Text // ["محاسب", ...] (والرموز إن وُجدت)
  phasesJson           String    @db.Text // [{"pct":40,"effectiveFrom":"2025-10-27"}, ...]
  minEstablishmentSize Int? // الحد الأدنى لعدد العاملين في المهن المستهدفة
  minWage              Float? // الحد الأدنى للأجر ليُحتسب السعودي
  scope                String?   @db.Text // النطاق الجغرافي أو الأنشطة
  decisionNo           String?
  decisionDate         DateTime?
  status               String // VERIFIED_PRIMARY, PARTIAL, PROVISIONAL, USER_INPUT
  sourceUrl            String?   @db.Text
  page                 Int?
  notes                String?   @db.Text
  createdById          String?
  createdAt            DateTime  @default(now())
  createdBy            User?     @relation("LocalizationDecisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupNameAr])
}

/// Limits a back-office user to some legal companies for official documents (docs/document-engine
/// SPEC §10). No rows = every company (default, backward compatible); owners are never limited.
model UserCompanyScope {
  userId      String
  companyId   String
  createdById String?
  createdAt   DateTime @default(now())

  user    User    @relation("ScopedUser", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("UserCompanyScopeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
}

// --- محرك القرارات (المرحلة 3): خطة القوى العاملة ---
// بيانات سيناريو فقط: لا تغيّر راتب أي موظف ولا تكتب SalaryChange (بوابة المال في تصميم PeopleOS).
model HeadcountPlan {
  id           String            @id @default(uuid())
  name         String
  companyId    String? // نطاق الخطة (فارغ = كل الشركات)
  fromMonth    DateTime // أول شهر في الخطة (أول يوم في الشهر)
  months       Int               @default(12) // 12 / 24 / 36
  attritionPct Float? // معدل الدوران السنوي المفترض (فارغ = المعدل الفعلي من تاريخ المنشأة)
  status       String            @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, ARCHIVED
  basedOnId    String? // نسخة منسوخة من خطة أخرى
  notes        String?           @db.Text
  createdById  String?
  submittedAt  DateTime?
  decidedById  String? // من اعتمد أو رفض (يختلف عن المنشئ)
  decidedAt    DateTime?
  decisionNote String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  positions    PlannedPosition[]
  raises       PlanRaise[]
  company      Company?          @relation("HeadcountPlanCompany", fields: [companyId], references: [id], onDelete: Restrict)
  basedOn      HeadcountPlan?    @relation("HeadcountPlanCopy", fields: [basedOnId], references: [id], onDelete: SetNull)
  copies       HeadcountPlan[]   @relation("HeadcountPlanCopy")
  createdBy    User?             @relation("HeadcountPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy    User?             @relation("HeadcountPlanDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([companyId])
}

// وظيفة مخططة: تعيين جديد، أو إحلال بديل لموظف يغادر، أو خروج مخطط
model PlannedPosition {
  id                 String        @id @default(uuid())
  planId             String
  kind               String // NEW_HIRE, BACKFILL, EXIT
  title              String
  companyId          String?
  branchId           String?
  departmentId       String?
  nationalityClass   String? // SAUDI, EXPAT, GCC (للتعيين والإحلال)
  gosiRegime         String? // NEW / OLD للسعودي (الافتراضي NEW للمعيّن الجديد)
  gender             String?
  occupationName     String?
  basicSalary        Float?
  housingAllowance   Float?
  otherAllowances    Float?
  dependentsCount    Int?
  medicalClass       String?
  startMonth         DateTime? // بداية التعيين أو الإحلال
  exitEmployeeId     String? // للخروج المخطط أو الموظف الذي يُستبدل
  exitMonth          DateTime?
  exitReason         String? // EMPLOYEE_EXIT_REASONS
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  plan               HeadcountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// زيادة مخططة ضمن الخطة (نسبة أو مبلغ) على نطاق محدد من تاريخ محدد
model PlanRaise {
  id             String        @id @default(uuid())
  planId         String
  scope          String // ALL, COMPANY, DEPARTMENT, EMPLOYEE
  scopeId        String?
  pct            Float?
  amount         Float?
  effectiveMonth DateTime
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  plan           HeadcountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ---------------------------------------------------------
// platform: transactional outbox, event consumption, operation keys, immutable audit
// (P1-FND-EVT, P1-FND-AUDIT; docs/architecture LIFECYCLE_MODEL §2.1-2.4, DOMAIN_BOUNDARIES §5.2).
// Sole writer: src/modules/platform. Status columns are guarded by CHECK constraints and the
// immutability rules by triggers in migration 9t_platform_events_audit (Prisma does not model them).
// ---------------------------------------------------------

/// kind: FACT
/// Transactional outbox: written by emitEvent(tx) inside the transition's transaction. The fact
/// columns are immutable and rows are never deleted (trigger); only the dispatch columns change.
model DomainEvent {
  id             String    @id @default(uuid())
  /// Recorded order. Delivery is ordered per (aggregateType, aggregateId) only (LIFECYCLE_MODEL §2.4).
  seq            BigInt    @unique @default(autoincrement())
  /// <domain>.<entity>.<pastTenseVerb>, e.g. leave.request.approved
  type           String
  aggregateType  String
  aggregateId    String
  companyId      String?
  actorId        String?
  payload        Json
  idempotencyKey String    @unique
  occurredAt     DateTime
  effectiveDate  DateTime? @db.Date
  recordedAt     DateTime  @default(now())
  /// PENDING | DISPATCHED (CHECK). DISPATCHED = every consumer of the type settled (DONE or DEAD).
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  leaseUntil     DateTime?
  dispatchedAt   DateTime?

  consumptions EventConsumption[]

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, seq])
  @@index([type, recordedAt])
  @@index([companyId])
}

/// kind: FACT
/// One row per (consumer, event): the consumer's effect and this row commit in the same transaction,
/// so a consumer runs at most once per event however often or concurrently the dispatcher runs.
model EventConsumption {
  id            String    @id @default(uuid())
  consumer      String
  eventId       String
  /// DONE | FAILED | DEAD (CHECK). FAILED is retried at nextAttemptAt; DEAD after maxAttempts.
  status        String
  /// Named outcome of a DONE consumption: APPLIED, or e.g. RETRO_ROUTED (ADR-0002 #14), NOT_APPLICABLE.
  outcome       String?
  attempts      Int       @default(0)
  lastError     String?   @db.Text
  nextAttemptAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([consumer, eventId])
  @@index([eventId])
  @@index([status, nextAttemptAt])
}

/// kind: FACT
/// Operation keys (LIFECYCLE_MODEL §2.2): a repeated key returns the recorded result, not a second effect.
model OperationLog {
  id           String    @id @default(uuid())
  operationKey String    @unique
  operation    String
  actorId      String?
  companyId    String?
  /// Hash of the request; the same key with a different fingerprint is refused.
  fingerprint  String?
  resultRef    String?
  result       Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([operation, createdAt])
}

/// kind: FACT
/// Append-only audit with before/after values, written by audit(tx) in the operation's transaction
/// (UPDATE, DELETE and TRUNCATE refused by trigger). No FK to User on purpose: deleting a user must
/// never rewrite the trail. The legacy AuditLog stays mutable (User FK ON DELETE SET NULL) until its
/// writers move here.
model AuditRecord {
  id           String   @id @default(uuid())
  seq          BigInt   @unique @default(autoincrement())
  /// USER | SYSTEM (CHECK)
  actorType    String
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  companyId    String?
  before       Json?
  after        Json?
  reason       String?  @db.Text
  operationKey String?
  ipAddress    String?
  occurredAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([companyId, occurredAt])
  @@index([operationKey])
}

// ---------------------------------------------------------
// platform: data invariants (P1-FND-INV; ARCHITECTURE_INVARIANTS §4.2, §4.3, ADR-0002 #1).
// Sole writer: src/modules/platform (reconcile + the discrepancy transitions). Status, severity and
// the two-person columns are guarded by CHECK constraints in migration 9w_invariants_discrepancies.
// No FK to Company / Employee / User on purpose (same as AuditRecord): a discrepancy survives the
// row it points to, and companyId NULL is a tenant-level finding (e.g. the document event chain).
// ---------------------------------------------------------

/// kind: PROJECTION (of the invariant checks; rebuilt by reconcile) + the human classification
/// One open-or-closed finding of an invariant, keyed by its fingerprint (rule + check + entity + period):
/// a repeated detection updates the row, never adds one.
model Discrepancy {
  id                      String    @id @default(uuid())
  /// sha256 of ruleId|checkId|entityType|entityId|period (UNIQUE: idempotent reconcile)
  fingerprint             String    @unique
  /// INV-… id (ARCHITECTURE_INVARIANTS §4.2)
  ruleId                  String
  /// Sub-check of the rule (scripts/lib/reconciliation-checks.mjs)
  checkId                 String
  /// Owning module of the invariant (DOMAIN_BOUNDARIES §5.2)
  domain                  String
  companyId               String?
  /// The employee the finding is about (the beneficiary of ADR-0002 #1; the gate scope of a settlement)
  subjectEmployeeId       String?
  entityType              String
  entityId                String
  /// YYYY-MM, or NULL when the finding has no period
  period                  String?
  /// INFO | WARNING | HIGH | BLOCKING (CHECK)
  severity                String
  /// Computed at detection from the severity and the rule's blocking scope
  blocking                Boolean
  /// Operations this finding blocks while OPEN (the L4 gate scope)
  blocks                  String[]
  expectedValue           Json?
  actualValue             Json?
  delta                   Json?
  /// UNCLASSIFIED | EXPECTED_* | … (CHECK: upper-case code)
  category                String    @default("UNCLASSIFIED")
  /// OPEN | EXPLAINED | RESOLVED | WAIVED | AUTO_CLOSED (CHECK)
  status                  String    @default("OPEN")
  /// NULL | EXPLANATION | WAIVER: waiting for the second person (or the owner confirmation of INV-PAY-03)
  pendingAction           String?
  detectedAt              DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  /// Number of detections: 1 + each reopening (a repeated run of the same finding does not count)
  occurrences             Int       @default(1)
  lastRunId               String?
  ownerUserId             String?
  explanation             String?   @db.Text
  explanationRef          String?
  explainedById           String?
  explainedAt             DateTime?
  explanationApprovedById String?
  explanationApprovedAt   DateTime?
  waiverReason            String?   @db.Text
  waivedById              String?
  waivedAt                DateTime?
  waiverApprovedById      String?
  waiverApprovedAt        DateTime?
  /// SELF_ACT_SINGLE_OPERATOR (ADR-0002 #1): the sole operator explained or waived alone
  selfActSingleOperator   Boolean   @default(false)
  /// NULL | PENDING | CONFIRMED | REJECTED (CHECK): owner confirmation over the DEC-PO-022 channel
  ownerConfirmation       String?
  ownerConfirmationRef    String?
  ownerConfirmedAt        DateTime?
  resolution              String?   @db.Text
  resolutionRef           String?
  resolvedAt              DateTime?
  resolvedById            String?
  closedAt                DateTime?
  version                 Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@index([companyId, status, severity])
  @@index([status, blocking])
  @@index([ruleId, companyId, status])
  @@index([subjectEmployeeId])
}

/// kind: FACT
/// One execution of one invariant for one company (companyId NULL = the tenant-level pass).
model InvariantRun {
  id         String   @id @default(uuid())
  /// Groups the rows of one reconcile call
  runId      String
  ruleId     String
  companyId  String?
  /// SCHEDULED | MANUAL | PRE_OPERATION (CHECK)
  trigger    String
  /// SUCCEEDED | FAILED (CHECK)
  status     String
  /// Start of the READ ONLY snapshot the checks read
  snapshotAt DateTime
  startedAt  DateTime
  finishedAt DateTime
  found      Int      @default(0)
  opened     Int      @default(0)
  reopened   Int      @default(0)
  autoClosed Int      @default(0)
  /// Per sub-check counts, INFO checks included (they are not recorded as discrepancies)
  results    Json?
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([runId])
  @@index([ruleId, companyId, startedAt])
}

// ---------------------------------------------------------
// Effective periods (P1-FND-EFF; DOMAIN_MODEL §1.3, ADR-0001 #9, ADR-0002 #3/#8/#12/#13).
// Uniform shape: validFrom inclusive, validTo exclusive (NULL = open), recordedAt (when the system
// learnt it), supersededAt + supersedeReason on the replaced row and supersedesId on its successor
// (no row is ever deleted; void = superseded without a successor), lineageId inherited by every
// successor, sourceType/sourceId (LEGACY_OPENING for the opening periods of migration 9u).
// Physical writer: src/modules/platform/effective only (ARCH-012), called by the owning module.
// Migration 9u_effective_periods adds what Prisma cannot model: the EXCLUDE constraint (no two
// non-superseded periods of one employee overlap, INV-EFF-01, btree_gist), CHECKs, the partial
// unique index of the legacy opening, and the append-only triggers.
// ---------------------------------------------------------

/// kind: FACT
/// Owner: lifecycle (DOMAIN_BOUNDARIES §5.2). From the first working day to the last working day + 1.
/// The one named exception to append-only: validTo is edited in place by lifecycle (ADR-0001 #9).
model EmploymentPeriod {
  id              String    @id @default(uuid())
  employeeId      String
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  lineageId       String
  supersedesId    String?   @unique
  supersededAt    DateTime?
  /// CORRECTION | CLOSE | VOID (CHECK), set together with supersededAt
  supersedeReason String?
  /// LEGACY_OPENING | ONBOARDING | … (CHECK: upper snake case)
  sourceType      String
  sourceId        String
  recordedAt      DateTime  @default(now())
  /// Actor (user id, or null for the system). No FK on purpose, as AuditRecord (ADR-0003).
  createdById     String?

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supersedes   EmploymentPeriod? @relation("EmploymentPeriodSupersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy EmploymentPeriod? @relation("EmploymentPeriodSupersede")

  @@index([employeeId, validFrom])
  @@index([lineageId])
  @@index([sourceType, sourceId])
}

/// Stored employment states (LIFECYCLE_MODEL §2.3). "On leave" and "overdue return" are computed
/// (BR-LCY-008), never stored.
enum EmploymentState {
  ACTIVE
  NOTICE
  TERMINATED
}

/// kind: FACT
/// Owner: lifecycle (DOMAIN_BOUNDARIES §5.2). The truth of the employment state (DEC-PO-119,
/// ARC-LCY-A1): one row per transition, written by lifecycle.transitionEmploymentState only
/// (ARCH-005), never updated or deleted (trigger, migration 9y); a correction is a new row that
/// names the row it replaces in supersedesId (ADR-0002 #3). Employee.employmentState / isTerminated /
/// terminationDate (and, through offboarding, exitReason / exitVoluntary) = the latest row not
/// superseded, in recording order (INV-LCY-01).
model EmploymentStateChange {
  id                  String           @id @default(uuid())
  employeeId          String
  /// EmploymentPeriod.lineageId of the employment the change belongs to (ADR-0002 #12). Null only on
  /// a legacy opening of an employee whose data cannot make a period (legacy.review says why).
  employmentLineageId String?
  /// The EmploymentPeriod row of that lineage in force when the change was recorded.
  periodId            String?
  /// HIRE | NOTICE | CANCEL_EXIT | NOTICE_END | TERMINATE | TERMINATE_IN_NOTICE | REHIRE | AMEND | VOID | LEGACY_OPENING (CHECK)
  transition          String
  fromState           EmploymentState?
  toState             EmploymentState
  /// Business date of the change: first working day (HIRE, REHIRE), last working day (exits), decision day (CANCEL_EXIT, VOID).
  effectiveDate       DateTime         @db.Date
  /// The projections after the change: last working day, exit reason (ExitReason dictionary), voluntary.
  terminationDate     DateTime?        @db.Date
  exitReason          String?
  exitVoluntary       Boolean?
  /// Written reason of the actor (audit context; not a projection).
  reason              String?
  /// The decision behind the change (EMPLOYEE_FILE, SETTLEMENT, LEAVE_ABSCOND, SYSTEM, LEGACY_OPENING…).
  sourceType          String
  sourceId            String
  /// Legal company of the employee when the change was recorded (company-scope key, ARC §5).
  companyId           String?
  /// Requester (user id) or null for the system. No FK on purpose, as AuditRecord (ADR-0003).
  actorId             String?
  /// Second person of a two-person act (BR-LCY-012).
  approvedById        String?
  /// SELF_ACT_SINGLE_OPERATOR: a two-person act done alone because no eligible second person existed (DEC-PO-035).
  singleOperator      Boolean          @default(false)
  operationKey        String           @unique
  supersedesId        String?          @unique
  /// Legacy opening only: the projection values found (DEC-PO-051). The review codes are rows of
  /// EmploymentMigrationReview since 9zd (openings recorded before 9zd still carry legacy.review; the rows are the truth).
  legacy              Json?
  recordedAt          DateTime         @default(now())
  /// Recording order (the "latest" of DEC-PO-119): strictly increasing, also inside one transaction.
  seq                 BigInt           @unique @default(autoincrement())

  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supersedes   EmploymentStateChange? @relation("EmploymentStateChangeSupersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy EmploymentStateChange? @relation("EmploymentStateChangeSupersede")
  migrationReviews EmploymentMigrationReview[]

  @@index([employeeId, recordedAt])
  @@index([employmentLineageId])
  @@index([companyId])
  @@index([sourceType, sourceId])
}

/// LCY-J1 review items (DEC-PO-051, DEC-PO-128 / ADR-0004 #2): what the opening of an employee's
/// employment state found that HR must look at (ACTIVE_WITH_TERMINATION_DATE, NOTICE_CANDIDATE…).
/// Owner lifecycle; written only by the SQL opening lifecycle_open_state (9zd, single definition), one
/// row per (employee, code). Only the resolution columns may change, once (trigger).
model EmploymentMigrationReview {
  id            String    @id @default(uuid())
  employeeId    String
  /// The LEGACY_OPENING state change that raised the item.
  stateChangeId String?
  /// Review code (CHECK: upper-case identifier).
  code          String
  /// The projection values found when the state was opened (before anything was cleared).
  details       Json      @default("{}")
  createdAt     DateTime  @default(now())
  /// HR follow-up (BL-LCY-006): set once, together.
  resolvedAt    DateTime?
  /// No FK on purpose, as AuditRecord (ADR-0003).
  resolvedById  String?
  resolution    String?

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  stateChange EmploymentStateChange? @relation(fields: [stateChangeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, code])
  @@index([code, resolvedAt])
  @@index([stateChangeId])
}

/// BL-LCY-015 effect log of a settlement approval (LCY-M1, DEC-PO-128 / ADR-0004 #1): one row per
/// value the approval changed, with its value before and after, so R1 (settlement.reverse) can restore
/// it. Owner offboarding; FACT, append-only (trigger); sole writer offboarding.recordSettlementEffects,
/// called by the approval in its transaction. Unique per (settlement, kind, reference): a repeat adds nothing.
model SettlementEffect {
  id           String   @id @default(uuid())
  settlementId String
  employeeId   String
  /// LOAN | OVERTIME | PAYROLL_DRAFT | LEAVE_ACCRUAL | PAYMENT_REQUEST | EMPLOYMENT | LOGIN (CHECK)
  kind         String
  /// The row the effect touched (loan, overtime request, payroll, payment request; the employee for employee-level values).
  refId        String
  before       Json?
  after        Json?
  recordedAt   DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([settlementId, kind, refId])
  @@index([employeeId])
}

/// kind: FACT
/// Owner: compensation (DOMAIN_BOUNDARIES §5.2). Basic salary and the fixed monthly allowances.
/// Amounts in SAR with halala precision (Decimal(14,2), DOMAIN_MODEL §1.4).
model CompensationPeriod {
  id               String    @id @default(uuid())
  employeeId       String
  validFrom        DateTime  @db.Date
  validTo          DateTime? @db.Date
  lineageId        String
  supersedesId     String?   @unique
  supersededAt     DateTime?
  supersedeReason  String?
  sourceType       String
  sourceId         String
  recordedAt       DateTime  @default(now())
  createdById      String?
  basicSalary      Decimal   @db.Decimal(14, 2)
  /// Fixed monthly allowances: [{ name, line: HOUSING|TRANSPORT|OTHER, allowanceType, amount, countsTowardGosi, allowanceId }]
  allowances       Json      @default("[]")
  /// Explicit GOSI contributory wage; null = basic + allowances flagged countsTowardGosi.
  gosiBaseOverride Decimal?  @db.Decimal(14, 2)

  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supersedes   CompensationPeriod? @relation("CompensationPeriodSupersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy CompensationPeriod? @relation("CompensationPeriodSupersede")
  financialChanges EmployeeFinancialChange[] // 9zg_financial_change (P1-PAY-B)

  @@index([employeeId, validFrom])
  @@index([lineageId])
  @@index([sourceType, sourceId])
}

/// kind: FACT
/// Owner: compensation (ARC-PAY-A3, ADR-0001 #8). The bank identity of an employee: the IBAN (encrypted,
/// src/lib/crypto.ts; a legacy opening keeps the stored value), its fingerprint (sha256 of the normalized
/// IBAN, BR-PAY-006) and last 4, the bank and the payment method. Never back-dated: validFrom is the
/// day the change is applied. Written through src/modules/platform/effective only (ARCH-012), called by
/// compensation only (ARCH-021). Employee.ibanNumber / bankName / salaryPaymentMethod are its projection.
model BankIdentityPeriod {
  id              String        @id @default(uuid())
  employeeId      String
  validFrom       DateTime      @db.Date
  validTo         DateTime?     @db.Date
  lineageId       String
  supersedesId    String?       @unique
  supersededAt    DateTime?
  supersedeReason String?
  sourceType      String
  sourceId        String
  recordedAt      DateTime      @default(now())
  createdById     String?
  ibanEncrypted   String?
  ibanFingerprint String?
  ibanLast4       String?
  bankName        String?
  paymentMethod   PaymentMethod

  employee         Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  supersedes       BankIdentityPeriod?       @relation("BankIdentityPeriodSupersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy     BankIdentityPeriod?       @relation("BankIdentityPeriodSupersede")
  financialChanges EmployeeFinancialChange[]

  @@index([employeeId, validFrom])
  @@index([lineageId])
  @@index([sourceType, sourceId])
  @@index([ibanFingerprint])
}

/// kind: REQUEST
/// Owner: compensation (BR-PAY-009, ARC-PAY-A2; SOURCE_OF_TRUTH "طلب تغيير مالي أو آيبان"). A change of an
/// employee's pay (field COMPENSATION) or bank identity (field BANK_IDENTITY) with an effective date:
/// PENDING -> PENDING_EFFECT -> APPLIED, or REJECTED / CANCELLED (CHECK). Decided by a second person
/// (requester != decider != the employee; SINGLE_OPERATOR: recorded self-act). No number is read from
/// it: applying it opens a CompensationPeriod / BankIdentityPeriod (compensation.applyDecision).
/// companyId is the scope key (the employee's legal company when filed).
model EmployeeFinancialChange {
  id                   String         @id @default(uuid())
  employeeId           String
  companyId            String?
  field                String // COMPENSATION | BANK_IDENTITY
  source               String // FORM | IMPORT | ONBOARDING | EDIT | PORTAL
  status               String         @default("PENDING") // LEGACY_UNVERIFIED | PENDING | PENDING_EFFECT | APPLIED | REJECTED | CANCELLED
  effectiveDate        DateTime       @db.Date
  /// COMPENSATION: the requested { basicSalary, allowances[], gosiBaseOverride } (CompensationAttrs)
  compensation         Json?
  /// BANK_IDENTITY: the IBAN encrypted (src/lib/crypto.ts), its fingerprint and last 4, the bank and method
  ibanEncrypted        String?
  ibanFingerprint      String?
  ibanLast4            String?
  bankName             String?
  paymentMethod        PaymentMethod?
  /// The applied values when the request was filed (display only; the IBAN masked)
  beforeJson           Json?
  note                 String?
  /// Rows filed by one import: approved together by another person (BR-PAY-009 IMPORT)
  batchKey             String?
  /// null only for a migrated LEGACY_UNVERIFIED request until the employee confirms it
  requestedById        String?
  /// LEGACY_UNVERIFIED: who filed (or touched) the original portal request; never a decider (G1b)
  legacyFiledByUserIds String[]       @default([])
  requestedAt          DateTime       @default(now())
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  /// The decision broke the second-person rule in a SINGLE_OPERATOR tenant (BR-PAY-020)
  decisionSelfAct      Boolean        @default(false)
  cancelledById        String?
  cancelledAt          DateTime?
  cancelReason         String?
  appliedAt            DateTime?
  compensationPeriodId String?
  bankIdentityPeriodId String?
  operationKey         String         @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy        User?               @relation("FinancialChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy          User?               @relation("FinancialChangeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  cancelledBy        User?               @relation("FinancialChangeCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  compensationPeriod CompensationPeriod? @relation(fields: [compensationPeriodId], references: [id], onDelete: Restrict)
  bankIdentityPeriod BankIdentityPeriod? @relation(fields: [bankIdentityPeriodId], references: [id], onDelete: Restrict)

  @@index([employeeId, field, status])
  @@index([companyId, status])
  @@index([status, effectiveDate])
  @@index([batchKey])
}

/// kind: FACT
/// Owner: org (DOMAIN_BOUNDARIES §5.2). Minimal set of P1-FND-EFF (ARC-SYS-A3); P3-ORG adds
/// position, cost centre and work pattern. legalCompanyId is the company-scope key (§5.4.3).
model AssignmentPeriod {
  id              String    @id @default(uuid())
  employeeId      String
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  lineageId       String
  supersedesId    String?   @unique
  supersededAt    DateTime?
  supersedeReason String?
  sourceType      String
  sourceId        String
  recordedAt      DateTime  @default(now())
  createdById     String?
  legalCompanyId  String
  actualCompanyId String?
  branchId        String?
  departmentId    String?
  managerId       String?
  workPatternId   String? // P1-CAL (9z_calendar): the WorkPattern (WorkSchedule) of the assignment

  employee      Employee          @relation("AssignmentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  legalCompany  Company           @relation("AssignmentLegalCompany", fields: [legalCompanyId], references: [id], onDelete: Restrict)
  actualCompany Company?          @relation("AssignmentActualCompany", fields: [actualCompanyId], references: [id], onDelete: Restrict)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager       Employee?         @relation("AssignmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  workPattern   WorkSchedule?     @relation("AssignmentWorkPattern", fields: [workPatternId], references: [id], onDelete: Restrict)
  supersedes    AssignmentPeriod? @relation("AssignmentPeriodSupersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy  AssignmentPeriod? @relation("AssignmentPeriodSupersede")

  @@index([employeeId, validFrom])
  @@index([lineageId])
  @@index([sourceType, sourceId])
  @@index([legalCompanyId])
  @@index([actualCompanyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([managerId])
  @@index([workPatternId])
}

// ---------------------------------------------------------------------------
// Workflow engine (WFE-001, 9zj_workflow_engine, ADR-0006). Owner: workflow.
// ---------------------------------------------------------------------------

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WorkflowInstanceStatus {
  RUNNING
  AWAITING_REQUIREMENT
  RETURNED
  PAUSED
  BLOCKED
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowCloseKind {
  DECIDED
  AUTO_APPROVED
  CANCELLED_BY_ACTOR
  RETURN_EXPIRED
  EXTERNAL
  MIGRATION
}

enum WorkflowTaskKind {
  APPROVE
  REJECT_PAIR
  CANCEL_CONFIRM
  REQUIREMENT_CHECK
  DEFERRAL_DECISION
}

enum WorkflowTaskStatus {
  OPEN
  APPROVED
  REJECTED
  RETURNED
  NOT_REQUIRED
  CANCELLED
}

/// kind: FACT
/// A versioned approval path. Owner: workflow (G6). An ACTIVE or RETIRED version is immutable (trigger);
/// companyId null = the tenant default (ARC-WFE-A7). Partial uniques and CHECKs live in the migration SQL.
model WorkflowDefinition {
  id             String                   @id @default(uuid())
  /// e.g. requests.general (format CHECK)
  requestType    String
  companyId      String?
  version        Int
  status         WorkflowDefinitionStatus @default(DRAFT)
  definitionJson Json
  /// sha256 hex of the canonical JSON
  checksum       String
  basedOnId      String?
  changeNote     String?
  createdById    String
  createdAt      DateTime                 @default(now())
  /// the login whose save produced the current draft content (null: the creator; 9zn, DEC-PO-146)
  lastEditedById String?
  activatedById  String?
  activatedAt    DateTime?
  /// the activation was the recorded single-operator exception to the two-person rule (9zn CHECK)
  activationSelfAct Boolean                @default(false)
  retiredById    String?
  /// DEC-PO-147: the first person's request to retire a version so that a looser one governs (9zn CHECK)
  retireRequestedById String?
  retireRequestedAt DateTime?
  /// what the requester reviewed: the version that would govern, and the sorted relaxation codes (9zn CHECK)
  retireFallbackId String?
  retireRelaxations String[]              @default([])
  /// the retirement was the recorded single-operator exception to the two-person rule
  retireSelfAct  Boolean                  @default(false)
  retiredAt      DateTime?
  updatedAt      DateTime                 @updatedAt

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  basedOn     WorkflowDefinition?  @relation("WorkflowDefinitionBasedOn", fields: [basedOnId], references: [id], onDelete: Restrict)
  derived     WorkflowDefinition[] @relation("WorkflowDefinitionBasedOn")
  createdBy   User                 @relation("WorkflowDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedBy User?               @relation("WorkflowDefinitionLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  retireRequestedBy User?          @relation("WorkflowDefinitionRetireRequestedBy", fields: [retireRequestedById], references: [id], onDelete: Restrict)
  retireFallback WorkflowDefinition? @relation("WorkflowDefinitionRetireFallback", fields: [retireFallbackId], references: [id], onDelete: Restrict)
  retireFallbackOf WorkflowDefinition[] @relation("WorkflowDefinitionRetireFallback")
  activatedBy User?                @relation("WorkflowDefinitionActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  retiredBy   User?                @relation("WorkflowDefinitionRetiredBy", fields: [retiredById], references: [id], onDelete: Restrict)
  instances   WorkflowInstance[]

  @@index([requestType, companyId, status])
}

/// kind: REQUEST
/// The approval decision for one request (polymorphic requestType + requestId, no FK). Owner: workflow.
/// companyId is the scope key (the beneficiaries company at start). version is the CAS counter.
/// hasPayEffect is CHECK = false in phase 2 (DEC-PO-139).
model WorkflowInstance {
  id                     String                  @id @default(uuid())
  companyId              String
  requestType            String
  requestId              String
  /// the pinned definition version (G6)
  definitionId           String
  status                 WorkflowInstanceStatus  @default(RUNNING)
  previousStatus         WorkflowInstanceStatus?
  version                Int                     @default(0)
  round                  Int                     @default(1)
  returns                Int                     @default(0)
  beneficiaryEmployeeIds String[]                @default([])
  /// null only for migrated rows (wfe-to-be section 17.3)
  requesterUserId        String?
  hasPayEffect           Boolean                 @default(false)
  contextSnapshotJson    Json                    @default("{}")
  managerChainSnapshot   Json                    @default("[]")
  pathTaken              Json                    @default("[]")
  /// a stack with set semantics; adapter codes
  pauseReasons           String[]                @default([])
  pausedAt               DateTime?
  blockedAt              DateTime?
  blockedReason          String?
  awaitingRequirement    String?
  awaitingSince          DateTime?
  effectFailedAt         DateTime?
  lastEffectError        String?
  startedAt              DateTime                @default(now())
  closedAt               DateTime?
  closeKind              WorkflowCloseKind?
  /// adapter code
  closeSource            String?
  closedByUserId         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  requesterUser User?              @relation("WorkflowInstanceRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  closedByUser  User?              @relation("WorkflowInstanceClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  tasks         WorkflowTask[]

  @@unique([requestType, requestId])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([requesterUserId])
  @@index([definitionId])
  @@index([beneficiaryEmployeeIds], type: Gin)
}

/// kind: REQUEST
/// One approver step of a WorkflowInstance. Owner: workflow. companyId equals the instance company,
/// enforced by the composite FK (instanceId, companyId).
model WorkflowTask {
  id                     String             @id @default(uuid())
  instanceId             String
  companyId              String
  round                  Int
  /// APPROVE tasks use the definition node id; other kinds use <kind>#<n>
  nodeId                 String
  kind                   WorkflowTaskKind   @default(APPROVE)
  status                 WorkflowTaskStatus @default(OPEN)
  candidateUserIds       String[]           @default([])
  /// [{userId, via: STAGE|COVER|OWNER_COVER|DELEGATE, reason?, onBehalfOf?}]
  candidatesSnapshotJson Json               @default("[]")
  dueAt                  DateTime?
  /// APPROVER_UNAVAILABLE / NO_MANAGER / MANAGER_ON_LEAVE / DEADLINE
  coverReason            String?
  overdueAt              DateTime?
  escalatedAt            DateTime?
  actedByUserId          String?
  onBehalfOfUserId       String?
  decisionFieldsJson     Json?
  /// the time the task was closed (any non-OPEN status)
  decidedAt              DateTime?
  note                   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  instance       WorkflowInstance @relation(fields: [instanceId, companyId], references: [id, companyId], onDelete: Restrict)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actedBy        User?            @relation("WorkflowTaskActedBy", fields: [actedByUserId], references: [id], onDelete: Restrict)
  onBehalfOfUser User?            @relation("WorkflowTaskOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict)

  @@unique([instanceId, round, nodeId, kind])
  @@index([companyId, status])
  @@index([candidateUserIds], type: Gin)
  @@index([actedByUserId])
}

/// kind: FACT
/// A grant of approval authority whose only state is revocation. Owner: workflow. One active delegate per
/// delegator at any moment (EXCLUDE constraint in the migration SQL, DEC-PO-103). companyIds[] means it is
/// not auto-scoped; workflow/scope.ts filters it. requestTypes empty = every type.
model ApprovalDelegation {
  id           String    @id @default(uuid())
  fromUserId   String
  toUserId     String
  companyIds   String[]
  requestTypes String[]  @default([])
  startsAt     DateTime
  endsAt       DateTime
  /// required when the creator is not the delegator
  reason       String?
  createdById  String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  fromUser  User  @relation("ApprovalDelegationFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User  @relation("ApprovalDelegationTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User  @relation("ApprovalDelegationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy User? @relation("ApprovalDelegationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([toUserId, startsAt])
  @@index([fromUserId, startsAt])
  @@index([companyIds], type: Gin)
}
