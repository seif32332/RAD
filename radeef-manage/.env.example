# radeef-manage — copy to radeef-manage/.env and fill in. NEVER commit the real .env.
# The panel refuses to start if any required value is missing or weak.

# ---------------------------------------------------------------- web panel
# Bind address. Keep 127.0.0.1 and publish through nginx (TLS + IP allow-list) or an SSH tunnel.
HOST=127.0.0.1
PORT=3099
# Single operator account. Password: at least 12 characters (use a generated passphrase).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Session cookie gets the Secure flag unless set to false (only for http://localhost via SSH tunnel).
COOKIE_SECURE=true
# Express "trust proxy" (for the client IP used by the login rate limit). loopback = nginx on the same host.
TRUST_PROXY=loopback
# SQLite registry path (default: radeef-manage/database.sqlite)
# DB_PATH=

# ---------------------------------------------------------------- SSH to the tenant server
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Private key (recommended). SSH_PASSWORD is only used when SSH_KEY_PATH is empty.
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_PASSWORD=
# Host key pin, e.g. "SHA256:abc..." from: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub (run on the server)
SSH_HOST_FINGERPRINT=
# Only for a first connectivity test. Never leave true.
SSH_ALLOW_UNVERIFIED_HOST=false

# ---------------------------------------------------------------- PostgreSQL (as seen FROM the tenant server)
# Admin connection used to create/drop tenant databases and roles and to run pg_dump.
# PGPASSWORD is sent to the server on stdin, never on a command line. Leave it empty to use
# ~/.pgpass on the server instead (recommended).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Host written into each tenant's DATABASE_URL (defaults to PGHOST).
TENANT_DB_HOST=localhost

# ---------------------------------------------------------------- layout on the tenant server
# Comma-separated allow-list of CLEAN release directories new tenants are copied from
# (a checkout of a release tag with `npm ci` done; no .env, no uploads). The first one is the default.
RELEASE_DIRS=/opt/radeef/release
# Where tenant app directories live (existing tenants are in /root/<name>).
TENANTS_ROOT=/root
# Per-tenant private data; UPLOAD_DIR=<DATA_ROOT>/<tenant>/uploads
DATA_ROOT=/var/lib/radeef
# pg_dump output: daily/ (pruned after BACKUP_RETENTION_DAYS), suspended/, deleted/ (kept), nginx/
BACKUP_DIR=/var/backups/radeef
BACKUP_RETENTION_DAYS=14
# Local copies of this panel's own .env + SQLite registry (taken with every backup run, chmod 600,
# also uploaded to BACKUP_DIR/panel on the server). Default: radeef-manage/backups
# PANEL_BACKUP_DIR=
# node-cron expressions in Asia/Riyadh. BACKUP_CRON=off disables the daily backup (not recommended).
BACKUP_CRON=30 2 * * *
LICENSE_CRON=0 0 * * *
LICENSE_CHECK_ON_START=true
# Reminder e-mails while 0 <= days left <= N (at most one per tenant per day, recorded in SQLite).
# A tenant is suspended only AFTER its end date (the end date itself is the last paid day).
LICENSE_REMINDER_DAYS=14
# First port tried for new tenants.
START_PORT=3005

# ---------------------------------------------------------------- nginx / TLS
BASE_DOMAIN=radeef-sa.com
# Wildcard certificate covering *.BASE_DOMAIN
WILDCARD_CERT_DIR=/etc/letsencrypt/live/radeef-sa.com-0001
# Domains outside the wildcard get a certificate via certbot --webroot (needs this e-mail).
CERTBOT_EMAIL=
ACME_WEBROOT=/var/www/letsencrypt
# Maintenance + suspended pages are uploaded here (must be readable by the nginx user).
STATUS_PAGES_DIR=/var/www/radeef-status

# ---------------------------------------------------------------- SMTP written into NEW tenant env files
# Empty until the owner approves a transactional mail provider (SPF/DKIM/DMARC) and it is listed in
# docs/processors.md. Provisioning shows which ones are missing but does not block.
TENANT_SMTP_HOST=
TENANT_SMTP_PORT=587
TENANT_SMTP_SECURE=
TENANT_SMTP_USER=
TENANT_SMTP_PASS=
TENANT_SMTP_FROM=

# ---------------------------------------------------------------- license e-mails (optional)
DEFAULT_CLIENT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_WHATSAPP_URL=https://wa.me/966593119252
