# =============================================================================
# Radeef HRMS - environment template
# Copy to `.env` for local development, or to /etc/radeef/<tenant>.env (chmod 600,
# owned by root) on the server. NEVER commit real values. One file per tenant.
# ops/new-tenant.sh generates a complete file with random secrets.
# =============================================================================

# --- Database (required) ------------------------------------------------------
# One dedicated Postgres role + database per tenant (never the `postgres` superuser).
# connection_limit caps the Prisma pool per process (DEC-004: 5 per app process; ops/deploy.sh
# gives the canary 2 and scripts/jobs.mjs uses 2). Budget: tenants x (5 + 2 + 2) + backups +
# migrations must stay below Postgres max_connections (add PgBouncer before raising it).
DATABASE_URL="postgresql://radeef_app:CHANGE_ME@localhost:5432/radeef?schema=public&connection_limit=5&pool_timeout=20"
#
# Per-role session limits (set once per role by ops/new-tenant.sh and radeef-manage; for an
# existing role run as the postgres superuser):
#   ALTER ROLE radeef_app SET statement_timeout = '30s';
#   ALTER ROLE radeef_app SET idle_in_transaction_session_timeout = '60s';
# Migrations must not inherit the 30s limit nor wait behind a long lock. ops/deploy.sh runs
# `prisma migrate deploy` with this parameter appended to DATABASE_URL (do the same by hand):
#   &options=-c%20lock_timeout%3D10s%20-c%20statement_timeout%3D15min

# --- Security (required in production) -----------------------------------------
# Signs the `radeef_session` JWT cookie. Random, at least 32 characters.
#   openssl rand -base64 48
# Rotating it logs every user out.
SESSION_SECRET=""

# AES-256-GCM key for encrypted DB fields (e.g. government platform passwords).
# Exactly 32 bytes, given as 64 hex chars or base64:
#   openssl rand -base64 32
# Keep it forever and back it up separately from the database: losing or changing it
# makes already-encrypted values unreadable.
DATA_ENCRYPTION_KEY=""

# Legacy fallback only (read when SESSION_SECRET is empty). Do not set on new tenants.
# NEXTAUTH_SECRET=""

# Session cookie `Secure` flag. Defaults to secure in production; set to "false" ONLY
# when serving production over plain HTTP (not recommended).
# COOKIE_SECURE="true"

# --- File storage -----------------------------------------------------------------
# Absolute directory for uploaded documents (outside public/). Files are served only
# through the authenticated /api/files route. Default: <app cwd>/uploads.
# Docker image: /app/uploads (mounted volume). PM2 on the VPS: /var/lib/radeef/<tenant>/uploads
UPLOAD_DIR="/var/lib/radeef/radeef/uploads"

# --- Outgoing e-mail (optional; e-mail features are skipped when unset) --------------
# Empty until the owner approves a transactional mail provider (SPF/DKIM/DMARC) and it is
# listed in docs/processors.md. scripts/jobs.mjs outbox-dispatch sends nothing unless
# OUTBOX_SEND="true" AND these are set.
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465), "false" for STARTTLS (587).
# Leave empty to derive it from the port (465 => true).
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Optional display sender, e.g. "\"نظام رديف\" <no-reply@example.com>"
SMTP_FROM=""

# --- First administrator (read ONLY by `npm run db:seed` / `npm run admin:create`) ----
# The app no longer has a built-in admin account. Remove ADMIN_PASSWORD from the file
# after the first admin is created.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional display name for the seeded admin (default: "مدير النظام").
# ADMIN_NAME=""
# `npm run admin:create -- <email>` uses NEW_ADMIN_PASSWORD when set (policy: 8+ chars, a letter
# and a digit); otherwise it generates a random password and prints it once. Pass it inline for
# that one command instead of storing it here.
# NEW_ADMIN_PASSWORD=""

# --- Runtime --------------------------------------------------------------------------
NODE_ENV="production"
# Listening port (one per tenant on the VPS: radeef 3000, rakan 3001, dar 3002).
PORT="3000"
# Standalone server bind address. Keep 127.0.0.1 behind Nginx on the VPS; the Docker
# image sets 0.0.0.0 and publishes the port on 127.0.0.1 only.
# HOSTNAME="127.0.0.1"

# Log every SQL query with parameters. Leaks PII into logs: debugging only.
PRISMA_LOG_QUERIES="false"

# --- Background jobs (scripts/jobs.mjs, run by a systemd timer / cron; see docs/RUNBOOK.md) ---
# Public URL used for the login link in digest e-mails (no link when empty).
APP_URL=""
# DRY RUN unless "true": outbox-dispatch only reports what it would send.
OUTBOX_SEND="false"
# Optional tuning: messages per run, lease length (seconds), retry limit for definite failures.
# OUTBOX_BATCH="20"
# OUTBOX_LEASE_SECONDS="300"
# OUTBOX_MAX_ATTEMPTS="3"

# --- Self clock-in: face verification service (services/face; see docs/RUNBOOK.md) -----
# Internal Python service on this server (one instance for all tenants, never exposed by Nginx).
# Empty = not configured: portal punches that need the face check are rejected (fail closed).
# PM2 / host: http://127.0.0.1:8090   Docker tenants: http://host.docker.internal:8090
FACE_SERVICE_URL=""
# Shared secret sent as "Authorization: Bearer ..." (same value as in /etc/radeef/services/face.env;
# that file is in a sub-folder on purpose: every /etc/radeef/*.env is treated as a tenant).
# Generate with: openssl rand -hex 32
FACE_SERVICE_TOKEN=""
