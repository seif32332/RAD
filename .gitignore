# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
id_rsa*
id_ed25519*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real secrets. Only the documented template is tracked.
.env
.env*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads (stored in UPLOAD_DIR, outside the repo) and legacy upload folder
/uploads
/public/uploads

# database dumps and backups
*.dump
*.sql.gz
/backups

# tenant manager runtime data
radeef-manage/database.sqlite
radeef-manage/.env

# face verification service: local virtualenvs, caches and DOWNLOADED models (scripts/download_models.py).
# The converted liveness models (fasnet_*.onnx) ARE committed.
services/face/.venv*/
__pycache__/
.pytest_cache/
services/face/models/face_detection_yunet_*.onnx
services/face/models/face_recognition_sface_*.onnx
services/face/models/*.part

.claude/
