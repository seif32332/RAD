# /etc/systemd/system/radeef-face.service: internal face verification service (installed by ops/face-setup.sh).
# One instance serves every tenant; it listens on 127.0.0.1 only and is never exposed by Nginx.
#
# It decodes images sent by employees, so it is isolated from the tenants: a dynamic user (not
# the tenants' "radeef" user), no view of their env files, uploads, backups or processes, and
# localhost-only networking.
[Unit]
Description=Radeef face verification service (127.0.0.1:8090)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/radeef/face/current
# FACE_SERVICE_TOKEN (chmod 600, read by systemd itself). Kept out of /etc/radeef/*.env, which lists tenants.
EnvironmentFile=/etc/radeef/services/face.env
Environment=PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENCV_IO_MAX_IMAGE_PIXELS=20000000
ExecStart=/opt/radeef/face/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 2 --no-server-header
Restart=on-failure
RestartSec=5
MemoryMax=1G
# A worker killed for memory is respawned by uvicorn instead of stopping the whole service.
OOMPolicy=continue
UMask=0077

# Only the service's own files are visible under /opt/radeef; tenant data is hidden.
TemporaryFileSystem=/opt/radeef:ro
BindReadOnlyPaths=/opt/radeef/face
InaccessiblePaths=-/etc/radeef -/var/lib/radeef -/var/backups/radeef
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
