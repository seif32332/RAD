# =============================================================================
# Radeef HRMS - Nginx site for tenant __TENANT__ (__DOMAIN__ -> 127.0.0.1:__PORT__)
# Rendered by ops/new-tenant.sh into /etc/nginx/sites-available/__DOMAIN__.conf.
# Placeholders: __TENANT__, __DOMAIN__, __PORT__. Do not edit the rendered file by hand;
# change this template and re-render (ops/new-tenant.sh --nginx-only ...).
#
# Upstream address lives in /etc/nginx/radeef-upstreams/__TENANT__.conf so ops/deploy.sh
# (Docker mode) can point Nginx at a canary while a container is recreated.
# =============================================================================

upstream radeef___TENANT__ {
    include /etc/nginx/radeef-upstreams/__TENANT__.conf;
    keepalive 16;
}

# ---- HTTP: ACME challenges + redirect everything else to HTTPS ----
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;

    # TLS (certificates issued by certbot --webroot, renewed by the certbot timer)
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:radeef_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No OCSP stapling: Let's Encrypt retired its OCSP responders in 2025.

    # Security headers. The app sends some of these too; hide the upstream copies so each
    # header appears exactly once.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header X-Powered-By;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Uploads are capped at 10 MB by the app; leave headroom for multipart overhead.
    client_max_body_size 12m;
    client_body_timeout 60s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml font/ttf font/otf;

    access_log /var/log/nginx/__TENANT__.access.log;
    error_log  /var/log/nginx/__TENANT__.error.log warn;

    # Generic maintenance page while the app is down or restarting (NOT a billing page).
    error_page 502 503 504 /__maintenance.html;
    location = /__maintenance.html {
        root /var/www/radeef-maintenance;
        internal;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "30" always;
    }

    # DEC-009: internal endpoints are never reachable from the internet. Every proxied request
    # comes from 127.0.0.1, so the app cannot tell "local" callers apart; background jobs run as
    # a CLI (scripts/jobs.mjs), not over HTTP.
    location ^~ /api/internal/ {
        return 404;
    }

    # Next already sends "Cache-Control: public, max-age=31536000, immutable" for /_next/static.
    # Do not add add_header inside locations: it would drop the server-level security headers.
    location / {
        proxy_pass http://radeef___TENANT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite (do not append): the app uses X-Real-IP (or the right-most X-Forwarded-For hop) for rate
        # limiting and audit logs, so a client-supplied value must never be passed through.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        # Payroll generation and Excel imports can take a while.
        proxy_read_timeout 120s;
        proxy_buffering on;
    }
}
